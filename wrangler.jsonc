{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "365-my-lines",
  "account_id": "9be9dbd05e5041652082ee0918150abf",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "365-my-lines-db",
      "database_id": "93ed3d7e-85c1-420a-ac84-52938e4f7c3c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "365-my-lines-images"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "e77488fc844a4c74bee3de850ad47ca7"
    },
    {
      "binding": "LOGIN_RATE_LIMIT",
      "id": "e74b77e3c6d34a8bb5721a5c7e500d0f"
    }
  ]
}
