{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "365-my-lines",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "365-my-lines-db",
      "database_id": "93ed3d7e-85c1-420a-ac84-52938e4f7c3c"
    }
  ]
}