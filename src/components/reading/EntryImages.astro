---
import type { EntryImageRecord } from "../../lib/db/entry-images";

interface Props {
  images: EntryImageRecord[];
  placement: "before" | "after";
}

const { images, placement } = Astro.props;
const label =
  placement === "before"
    ? "Фотографии перед текстом"
    : "Фотографии после текста";
---

{
  images.length > 0 && (
    <section
      class:list={[
        "reading-images",
        `reading-images--${placement}`,
        { "reading-images--single": images.length === 1 },
      ]}
      aria-label={label}
    >
      {images.map((image) => {
        const orientation =
          image.height > image.width * 1.12
            ? "portrait"
            : image.width > image.height * 1.22
              ? "landscape"
              : "square";

        return (
          <figure
            class:list={[
              "reading-photo",
              `reading-photo--${orientation}`,
            ]}
          >
            <div class="reading-photo__frame">
              <img
                src={`/media/images/${image.id}`}
                alt={image.caption ?? ""}
                width={image.width}
                height={image.height}
                loading={placement === "before" ? "eager" : "lazy"}
                decoding="async"
              />
            </div>
            {image.caption && <figcaption>{image.caption}</figcaption>}
          </figure>
        );
      })}
    </section>
  )
}

<style>
  .reading-images {
    display: grid;
    width: min(100%, 700px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.2rem);
    margin-inline: auto;
  }

  .reading-images--before {
    margin-top: clamp(2rem, 4vw, 3rem);
    margin-bottom: clamp(2.2rem, 4.5vw, 3.4rem);
  }

  .reading-images--after {
    margin-top: clamp(2.8rem, 6vw, 4.5rem);
  }

  .reading-images--single {
    display: block;
    width: min(100%, 620px);
  }

  .reading-photo {
    min-width: 0;
    margin: 0;
    break-inside: avoid;
    text-align: center;
  }

  .reading-images--single .reading-photo--portrait {
    width: min(100%, 430px);
    margin-inline: auto;
  }

  .reading-photo__frame {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(75, 56, 39, 0.13);
    background: rgba(255, 252, 246, 0.38);
    box-shadow:
      0 16px 38px rgba(52, 39, 27, 0.095),
      0 2px 7px rgba(52, 39, 27, 0.055);
  }

  .reading-photo__frame::after {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(255, 255, 255, 0.32);
    content: "";
    pointer-events: none;
  }

  img {
    display: block;
    width: 100%;
    max-height: min(72svh, 760px);
    object-fit: contain;
  }

  figcaption {
    max-width: 38ch;
    margin: 0.8rem auto 0;
    color: var(--muted);
    font-family: var(--font-heading);
    font-size: clamp(0.9rem, 1.5vw, 1.02rem);
    font-style: italic;
    line-height: 1.5;
    text-wrap: balance;
  }

  @media (max-width: 620px) {
    .reading-images {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }

    .reading-images--before {
      margin-top: 1.8rem;
      margin-bottom: 2.3rem;
    }

    .reading-images--after {
      margin-top: 3rem;
    }

    .reading-photo,
    .reading-images--single .reading-photo--portrait {
      width: 100%;
    }

    img {
      max-height: 76svh;
    }

    figcaption {
      margin-top: 0.7rem;
      padding-inline: 0.5rem;
      font-size: 0.94rem;
    }
  }
</style>
