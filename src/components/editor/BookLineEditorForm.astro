---
import EditorActions from "./EditorActions.astro";
import EditorMeta from "./EditorMeta.astro";

interface Props {
  number: number;
  lineDate: string;
  title: string;
  content: string;
  readingUrl: string;
}

const { number, lineDate, title, content, readingUrl } = Astro.props;
---

<form class="paper" id="edit-form" novalidate>
  <header class="editor-header">
    <label>
      СТРОКА
      <input name="number" id="number" type="number" min="1" max="365" value={number} />
    </label>
    <input name="lineDate" id="lineDate" type="date" value={lineDate} />
  </header>

  <input class="title" name="title" id="title" value={title} maxlength="160" required />

  <div class="ornament" aria-hidden="true">
    <span></span><b>✦</b><span></span>
  </div>

  <textarea name="content" id="content" required>{content}</textarea>

  <EditorMeta class="paper-footer" statusText="Изменения сохраняются в черновик" />
  <p id="message" aria-live="polite"></p>

  <div class="actions">
    <button class="delete" id="open-delete-dialog" type="button">Удалить страницу</button>
    <EditorActions
      class="primary-actions"
      cancelHref={readingUrl}
      saveLabel="Сохранить изменения"
      saveButtonId="save"
    />
  </div>
</form>

<style>
  .paper {
    width: min(100%, 780px);
    margin: 3rem auto 0;
    padding: clamp(2.5rem, 7vw, 5.5rem) clamp(1.5rem, 7vw, 5.5rem) 2rem;
    background: rgba(251, 248, 242, 0.62);
    border: 1px solid rgba(58, 47, 36, 0.09);
    box-shadow: 0 24px 70px rgba(52, 41, 29, 0.06);
  }

  .editor-header {
    display: flex;
    justify-content: space-between;
    color: var(--accent);
    font-size: 0.78rem;
  }

  .editor-header label {
    display: flex;
    gap: 0.4rem;
  }

  .editor-header input {
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    color: inherit;
  }

  #number {
    width: 3.2rem;
    text-align: center;
  }

  .title {
    width: 100%;
    margin: 4rem 0 1.8rem;
    border: 0;
    outline: 0;
    background: transparent;
    text-align: center;
    font-family: var(--font-heading);
    font-size: clamp(2.7rem, 8vw, 5rem);
    color: var(--ink);
  }

  .ornament {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    width: min(100%, 460px);
    margin: 0 auto 4rem;
    color: var(--accent);
  }

  .ornament span {
    height: 1px;
    background: var(--line);
  }

  textarea {
    display: block;
    width: 100%;
    height: clamp(360px, 52vh, 620px);
    min-height: 360px;
    max-height: 620px;
    padding: 0 0.75rem 0 0;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
    resize: none;
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    font-size: 1.12rem;
    line-height: 1.95;
    color: var(--ink);
  }

  .paper-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.4rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    font-size: 0.76rem;
    color: var(--muted);
  }

  .paper-footer :global(p) {
    margin: 0;
  }

  #message {
    min-height: 1.4rem;
    text-align: center;
    color: #9a493f;
  }

  .actions,
  .primary-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .primary-actions :global(a) {
    color: var(--muted);
    text-decoration: none;
  }

  .actions :global(button) {
    padding: 0.85rem 1.2rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper-light);
    font: inherit;
    cursor: pointer;
  }

  .actions .delete {
    padding: 0;
    border: 0;
    background: transparent;
    color: #9a493f;
  }

  .actions :global(button:disabled) {
    opacity: 0.68;
    cursor: default;
  }

  @media (max-width: 650px) {
    .paper {
      margin-top: 1.5rem;
      padding: 2rem 1.1rem;
      box-shadow: none;
    }

    .actions {
      align-items: flex-end;
    }

    .primary-actions :global(a) {
      display: none;
    }
  }
</style>
