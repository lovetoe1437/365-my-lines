---
import type { EntryImageRecord } from "../../lib/db/entry-images";

interface Props {
  images?: EntryImageRecord[];
}

const { images = [] } = Astro.props;
---

<section class="entry-images" data-entry-image-editor>
  <header class="entry-images__header">
    <div>
      <p class="entry-images__eyebrow">Фотографии страницы</p>
      <p class="entry-images__hint">До шести фотографий — перед текстом или после него.</p>
    </div>
    <span class="entry-images__count" data-image-count>{images.length} / 6</span>
  </header>

  <div class="entry-images__list" data-image-list>
    {images.map((image) => (
      <article
        class="entry-images__item"
        data-image-id={image.id}
        data-image-url={`/media/images/${image.id}`}
        data-image-placement={image.placement}
        data-image-caption={image.caption ?? ""}
      >
        <img src={`/media/images/${image.id}`} alt="" />
      </article>
    ))}
  </div>

  <p class="entry-images__empty" data-image-empty hidden={images.length > 0}>
    Фотографии пока не выбраны.
  </p>

  <label class="entry-images__add">
    <span>＋ Добавить фотографию</span>
    <input
      data-image-input
      type="file"
      accept="image/jpeg,image/png,image/webp,image/heic,image/heif,.jpg,.jpeg,.png,.webp,.heic,.heif"
      multiple
    />
  </label>
  <p class="entry-images__note">JPEG, PNG, WebP или HEIC · до 15 МБ каждая</p>
  <p class="entry-images__message" data-image-message aria-live="polite"></p>
</section>
