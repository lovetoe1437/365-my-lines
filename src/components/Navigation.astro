---
import { getNavigationState } from "../lib/ui/navigation";

const {
  isBookActive,
  isDiaryActive,
  isBookEditor,
  isDiaryEditor,
  createHref,
  createLabel,
} = getNavigationState(Astro.url.pathname);
---
<header class="site-header" data-site-header>
  <nav class="site-navigation" aria-label="Основная навигация">
    <a class="site-brand" href="/"><span>365</span> моих строк</a>

    <button class="site-navigation__menu" type="button" aria-label="Открыть меню" aria-expanded="false" data-menu-button>
      <span></span><span></span><span></span>
    </button>

    <div class="site-navigation__panel" data-menu-panel>
      <div class="site-navigation__center">
        <a class:list={["site-navigation__link",{"is-active":isBookActive}]} href="/lines">Книга</a>
        <span class="site-navigation__ornament" aria-hidden="true">✦</span>
        <a class:list={["site-navigation__link",{"is-active":isDiaryActive}]} href="/book">Дневник</a>
      </div>
      <a class:list={["site-navigation__write",{"is-active":isBookEditor || isDiaryEditor}]} href={createHref}>
        <span>{createLabel}</span><span aria-hidden="true">✎</span>
      </a>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");

  button?.addEventListener("click", () => {
    const isOpen = header?.classList.toggle("is-menu-open") ?? false;
    button.setAttribute("aria-expanded", String(isOpen));
    button.setAttribute("aria-label", isOpen ? "Закрыть меню" : "Открыть меню");
  });

  panel?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      header?.classList.remove("is-menu-open");
      button?.setAttribute("aria-expanded", "false");
    });
  });
</script>

<style>
.site-header{position:relative;z-index:30;width:100%;border-bottom:1px solid var(--line);background:rgba(248,243,234,.78);backdrop-filter:blur(20px) saturate(112%);-webkit-backdrop-filter:blur(20px) saturate(112%)}
.site-navigation{display:grid;grid-template-columns:1fr minmax(0,2fr);align-items:center;gap:2rem;width:min(calc(100% - 3rem),1180px);min-height:68px;margin:0 auto}
.site-brand,.site-navigation__link,.site-navigation__write{color:var(--ink);text-decoration:none;transition:color 180ms ease,opacity 180ms ease}.site-brand{position:relative;justify-self:start;font-family:var(--font-heading);font-size:1.18rem;font-weight:600;letter-spacing:.01em}.site-brand span{color:var(--accent)}
.site-brand::before{position:absolute;right:calc(100% + .65rem);top:50%;width:20px;height:1px;background:var(--line-strong);content:"";opacity:0;transform:translateY(-50%) scaleX(.35);transform-origin:right;transition:opacity var(--transition-fast),transform var(--transition-normal)}.site-brand:hover::before{opacity:1;transform:translateY(-50%) scaleX(1)}
.site-navigation__panel{display:grid;grid-template-columns:1fr auto 1fr;align-items:center}.site-navigation__center{grid-column:2;display:flex;align-items:center;justify-content:center;gap:1.8rem}.site-navigation__link,.site-navigation__write{position:relative;padding-block:.45rem;font-size:.86rem}.site-navigation__link::after,.site-navigation__write::after{position:absolute;right:0;bottom:0;left:0;height:1px;background:currentColor;content:"";opacity:0;transform:scaleX(.45);transition:opacity 180ms ease,transform 180ms ease}.site-navigation__link:hover::after,.site-navigation__link.is-active::after,.site-navigation__write:hover::after,.site-navigation__write.is-active::after{opacity:1;transform:scaleX(1)}.site-navigation__ornament{color:var(--accent);font-size:.58rem}.site-navigation__write{grid-column:3;display:inline-flex;align-items:center;justify-self:end;gap:.55rem}.site-brand:hover,.site-navigation__link:hover,.site-navigation__write:hover{color:var(--accent)}.site-navigation__write span:last-child{transition:transform var(--transition-normal)}.site-navigation__write:hover span:last-child{transform:rotate(-8deg) translateY(-1px)}
.site-navigation__menu{display:none;width:38px;height:38px;padding:8px}.site-navigation__menu span{display:block;width:100%;height:1px;margin:5px 0;background:var(--ink);transition:transform var(--transition-normal),opacity var(--transition-fast)}
@media(max-width:700px){.site-navigation{grid-template-columns:1fr auto;width:min(calc(100% - 2rem),1180px);min-height:60px;gap:1rem}.site-navigation__menu{display:block;justify-self:end}.site-navigation__panel{position:absolute;top:100%;right:0;left:0;display:grid;grid-template-columns:1fr;gap:0;padding:0 1rem;background:rgba(248,243,234,.97);border-bottom:1px solid var(--line);box-shadow:0 18px 35px rgba(55,39,27,.08);opacity:0;visibility:hidden;transform:translateY(-8px);transition:opacity var(--transition-fast),visibility var(--transition-fast),transform var(--transition-normal)}.site-navigation__center{grid-column:1;display:grid;grid-template-columns:1fr auto 1fr;width:100%;padding:1rem 0;border-bottom:1px solid var(--line)}.site-navigation__write{grid-column:1;justify-self:stretch;justify-content:center;padding:1rem 0}.site-header.is-menu-open .site-navigation__panel{opacity:1;visibility:visible;transform:none}.site-header.is-menu-open .site-navigation__menu span:nth-child(1){transform:translateY(6px) rotate(45deg)}.site-header.is-menu-open .site-navigation__menu span:nth-child(2){opacity:0}.site-header.is-menu-open .site-navigation__menu span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}}
</style>
