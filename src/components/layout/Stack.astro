---
interface Props {
  as?: "div" | "section" | "article" | "ul" | "ol" | "header" | "footer";
  gap?: "none" | "xs" | "sm" | "md" | "lg" | "xl";
  align?: "stretch" | "start" | "center" | "end";
  class?: string;
}

const {
  as: Tag = "div",
  gap = "md",
  align = "stretch",
  class: className = "",
} = Astro.props;
---

<Tag class:list={["ds-stack", `ds-stack--${gap}`, `ds-stack--align-${align}`, className]}>
  <slot />
</Tag>
