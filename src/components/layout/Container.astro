---
interface Props {
  as?: "div" | "main" | "section" | "article" | "header" | "footer" | "nav";
  size?: "page" | "reading" | "wide" | "full";
  gutter?: "none" | "sm" | "md" | "lg";
  class?: string;
}

const {
  as: Tag = "div",
  size = "page",
  gutter = "md",
  class: className = "",
} = Astro.props;
---

<Tag class:list={["ds-container", `ds-container--${size}`, `ds-container--gutter-${gutter}`, className]}>
  <slot />
</Tag>
