---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const {
  title = "365 моих строк",
  description = "Личная книга мыслей, чувств и воспоминаний.",
  class: bodyClass = "",
} = Astro.props;

const pageTitle =
  title === "365 моих строк"
    ? title
    : `${title} — 365 моих строк`;

const pathname = Astro.url.pathname;

const showNavigation =
  pathname === "/book" ||
  pathname === "/write" ||
  pathname.startsWith("/pages/") ||
  pathname === "/lines" ||
  pathname.startsWith("/lines/");

const isBookActive =
  pathname === "/lines" ||
  pathname.startsWith("/lines/");

const isDiaryActive =
  pathname === "/book" ||
  pathname.startsWith("/pages/");

const isWriteActive = pathname === "/write";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4eee3" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Literata:opsz,wght@7..72,400;7..72,500;7..72,600&display=swap"
      rel="stylesheet"
    />

    <title>{pageTitle}</title>
  </head>

  <body class={bodyClass}>
    {
      showNavigation && (
        <header class="site-header">
          <nav class="site-navigation" aria-label="Основная навигация">
            <a class="site-brand" href="/book">
              365 моих строк
            </a>

            <div class="site-navigation__center">
              <a
                class:list={[
                  "site-navigation__link",
                  { "is-active": isBookActive },
                ]}
                href="/lines"
                aria-current={isBookActive ? "page" : undefined}
              >
                Книга
              </a>

              <span class="site-navigation__ornament" aria-hidden="true">
                ✦
              </span>

              <a
                class:list={[
                  "site-navigation__link",
                  { "is-active": isDiaryActive },
                ]}
                href="/book"
                aria-current={isDiaryActive ? "page" : undefined}
              >
                Дневник
              </a>
            </div>

            <a
              class:list={[
                "site-navigation__write",
                { "is-active": isWriteActive },
              ]}
              href="/write"
              aria-current={isWriteActive ? "page" : undefined}
            >
              <span>Новая запись</span>
              <span aria-hidden="true">✎</span>
            </a>
          </nav>
        </header>
      )
    }

    <div class="app-shell">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  .site-header {
    position: relative;
    z-index: 20;
    width: 100%;
    border-bottom: 1px solid rgba(58, 47, 36, 0.14);
    background: rgba(244, 238, 227, 0.94);
    backdrop-filter: blur(14px);
  }

  .site-navigation {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
    width: min(calc(100% - 3rem), 1180px);
    min-height: 68px;
    margin: 0 auto;
  }

  .site-brand,
  .site-navigation__link,
  .site-navigation__write {
    color: var(--ink);
    text-decoration: none;
    transition:
      color 180ms ease,
      opacity 180ms ease;
  }

  .site-brand {
    justify-self: start;
    font-family: "Cormorant Garamond", serif;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .site-navigation__center {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.8rem;
  }

  .site-navigation__link,
  .site-navigation__write {
    position: relative;
    padding-block: 0.45rem;
    font-size: 0.9rem;
  }

  .site-navigation__link::after,
  .site-navigation__write::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
    opacity: 0;
    transform: scaleX(0.45);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .site-navigation__link:hover::after,
  .site-navigation__link.is-active::after,
  .site-navigation__write:hover::after,
  .site-navigation__write.is-active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .site-navigation__ornament {
    color: var(--accent);
    font-size: 0.62rem;
  }

  .site-navigation__write {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: 0.55rem;
  }

  @media (max-width: 700px) {
    .site-navigation {
      grid-template-columns: 1fr auto;
      gap: 1rem;
      width: min(calc(100% - 2rem), 1180px);
      min-height: auto;
      padding-block: 1rem;
    }

    .site-navigation__center {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: space-between;
      width: 100%;
      padding-top: 0.8rem;
      border-top: 1px solid rgba(58, 47, 36, 0.12);
    }

    .site-navigation__write {
      grid-column: 2;
      grid-row: 1;
    }
  }

  @media (max-width: 380px) {
    .site-brand {
      font-size: 1rem;
    }

    .site-navigation__center {
      gap: 1rem;
    }

    .site-navigation__write {
      font-size: 0.82rem;
    }
  }
</style>
