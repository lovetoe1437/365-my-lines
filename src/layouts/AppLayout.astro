---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const {
  title = "365 моих строк",
  description = "Личная книга мыслей, чувств и воспоминаний.",
  class: bodyClass = "",
} = Astro.props;

const pageTitle =
  title === "365 моих строк"
    ? title
    : `${title} — 365 моих строк`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4eee3" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Literata:opsz,wght@7..72,400;7..72,500;7..72,600&display=swap"
      rel="stylesheet"
    />

    <title>{pageTitle}</title>
  </head>

  <body class={bodyClass}>
    <main class="app-shell">
      <slot />
    </main>
  </body>
</html>
