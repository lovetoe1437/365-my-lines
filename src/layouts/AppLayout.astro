---
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
import AppDialog from "../components/AppDialog.astro";
import AppToast from "../components/AppToast.astro";
import { shouldShowNavigation } from "../lib/ui/navigation";

interface Props {
  title?: string;
  description?: string;
  class?: string;
  hideNavigation?: boolean;
  image?: string;
  noindex?: boolean;
}

const {
  title = "365 моих строк",
  description = "Личная книга мыслей, чувств и воспоминаний.",
  class: bodyClass = "",
  hideNavigation = false,
  image = "/og-cover.png",
  noindex = false,
} = Astro.props;

const pageTitle = title === "365 моих строк" ? title : `${title} — 365 моих строк`;
const showNavigation = !hideNavigation && shouldShowNavigation(Astro.url.pathname);
const canonicalURL = new URL(Astro.url.pathname, Astro.url.origin);
const socialImageURL = new URL(image, Astro.url.origin);
const privatePath = /^\/(admin|api|login|write|diary\/write|lines\/write|lines\/[^/]+\/edit|pages\/[^/]+\/edit|unspoken\/edit)(\/|$)/.test(Astro.url.pathname);
const shouldNoindex = noindex || privatePath;
const shouldTrackEngagement = !privatePath
  && !/^\/(access|prologue)(\/|$)/.test(Astro.url.pathname);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4eee3" />
    <meta name="color-scheme" content="light" />
    <meta name="author" content="365 моих строк" />
    <meta name="robots" content={shouldNoindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest?v=2" />

    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="365 моих строк" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Обложка цифровой книги «365 моих строк»" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

  </head>

  <body class={bodyClass}>
    {showNavigation && <Navigation />}
    <main class="app-shell">
      <slot />
    </main>
    <AppDialog />
    <AppToast />
    {shouldTrackEngagement && (
      <script>
        const startedAt = Date.now();
        let visibleSince = document.visibilityState === "visible" ? performance.now() : null;
        let activeMilliseconds = 0;
        let sent = false;

        const updateActiveTime = () => {
          if (visibleSince !== null) {
            activeMilliseconds += performance.now() - visibleSince;
            visibleSince = null;
          }
        };

        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState === "visible") {
            visibleSince = performance.now();
          } else {
            updateActiveTime();
          }
        });

        window.addEventListener("pagehide", () => {
          if (sent) return;
          updateActiveTime();
          sent = true;
          navigator.sendBeacon(
            "/api/visits/engagement",
            JSON.stringify({
              path: window.location.pathname,
              startedAt,
              activeSeconds: Math.round(activeMilliseconds / 1000),
            }),
          );
        }, { once: true });
      </script>
    )}
  </body>
</html>
