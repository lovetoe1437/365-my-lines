---
import AppLayout from "../../layouts/AppLayout.astro";
import { env } from "cloudflare:workers";
import { getPage } from "../../lib/db/pages";

export const prerender = false;

const rawId = Astro.params.id;
const id = Number(rawId);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/book");
}

const page = await getPage(env.DB, id);

if (!page) {
  return new Response("Страница не найдена", {
    status: 404,
  });
}

const formatDate = (value: string) => {
  const date = new Date(value.replace(" ", "T") + "Z");

  return new Intl.DateTimeFormat("ru-RU", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
};
---

<AppLayout
  title={`${page.title} — 365 моих строк`}
  description={page.content.slice(0, 150)}
  class="reading-page"
>
  <main class="reading">
    <header class="reading__header">
      <a class="reading__back" href="/book">
        ← Вернуться в книгу
      </a>

      <p class="reading__label">Личный дневник</p>
    </header>

    <article class="reading__page">
      <time class="reading__date" datetime={page.created_at}>
        {formatDate(page.created_at)}
      </time>

      <h1 class="reading__title">{page.title}</h1>

      <div class="reading__divider" aria-hidden="true">
        <span></span>
        <span class="reading__ornament">✦</span>
        <span></span>
      </div>

      <div class="reading__content">
        {
          page.content.split(/\r?\n/).map((paragraph) =>
            paragraph.trim() ? <p>{paragraph}</p> : <br />
          )
        }
      </div>

      <div class="reading__actions">
        <a class="reading__edit" href={`/pages/${page.id}/edit`}>
          Редактировать
        </a>

        <button
          id="open-delete-dialog"
          class="reading__delete"
          type="button"
        >
          Удалить
        </button>
      </div>
    </article>

    <footer class="reading__footer">
      <a href="/book">← Вернуться к другим страницам</a>
    </footer>
  </main>

  <dialog id="delete-dialog" class="delete-dialog">
    <div class="delete-dialog__header">
      <p class="delete-dialog__label">Подтверждение</p>
      <h2>Удалить запись?</h2>
    </div>

    <div class="delete-dialog__content">
      <p class="delete-dialog__text">
        Эта страница будет удалена навсегда. Восстановить её после удаления
        будет невозможно.
      </p>

      <div class="delete-dialog__actions">
        <button id="cancel-delete" class="cancel-button" type="button">
          Отмена
        </button>

        <button id="confirm-delete" class="confirm-delete-button" type="button">
          Удалить
        </button>
      </div>
    </div>
  </dialog>
</AppLayout>

<script define:vars={{ id }}>
  const deleteDialog = document.getElementById("delete-dialog");
  const openDeleteDialogButton = document.getElementById(
    "open-delete-dialog"
  );
  const cancelDeleteButton = document.getElementById("cancel-delete");
  const confirmDeleteButton = document.getElementById("confirm-delete");

  openDeleteDialogButton?.addEventListener("click", () => {
    if (deleteDialog instanceof HTMLDialogElement) {
      deleteDialog.showModal();
    }
  });

  cancelDeleteButton?.addEventListener("click", () => {
    if (deleteDialog instanceof HTMLDialogElement) {
      deleteDialog.close();
    }
  });

  deleteDialog?.addEventListener("click", (event) => {
    if (
      deleteDialog instanceof HTMLDialogElement &&
      event.target === deleteDialog
    ) {
      deleteDialog.close();
    }
  });

  confirmDeleteButton?.addEventListener("click", async () => {
    if (!(confirmDeleteButton instanceof HTMLButtonElement)) {
      return;
    }

    confirmDeleteButton.disabled = true;
    confirmDeleteButton.textContent = "Удаляем…";

    try {
      const response = await fetch(`/api/pages/${id}`, {
        method: "DELETE",
      });

      const result = await response.json();

      if (response.ok && result.ok) {
        window.location.href = "/book";
        return;
      }

      alert(
        result.message ??
          "Не удалось удалить запись. Попробуй ещё раз."
      );
    } catch (error) {
      console.error("Не удалось удалить запись:", error);
      alert("Произошла ошибка соединения. Попробуй ещё раз.");
    } finally {
      confirmDeleteButton.disabled = false;
      confirmDeleteButton.textContent = "Удалить";
    }
  });
</script>

<style>
  :global(.reading-page) {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at top,
        rgba(255, 255, 255, 0.58),
        transparent 42%
      ),
      var(--paper);
  }

  .reading {
    width: min(100%, 760px);
    min-height: 100vh;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .reading__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .reading__back {
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .reading__back:hover {
    color: var(--ink);
  }

  .reading__label {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .reading__page {
    margin-top: clamp(5rem, 10vw, 8rem);
  }

  .reading__date {
    display: block;
    font-size: 0.9rem;
    color: var(--muted);
  }

.reading__title {
  margin: 1.1rem 0 0;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(3.5rem, 9vw, 6.2rem);
  font-weight: 500;
  line-height: 0.98;
  letter-spacing: -0.02em;
  font-variant-numeric: lining-nums;
  font-feature-settings: "lnum" 1;
  color: var(--ink);
}

  .reading__divider {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    width: min(100%, 420px);
    margin: 2.5rem 0 3.5rem;
    color: var(--accent);
  }

.reading__divider span:not(.reading__ornament) {
  height: 1px;
  background: rgba(58, 47, 36, 0.28);
}

  .reading__ornament {
    font-size: 0.75rem;
  }

.reading__content {
  max-width: 680px;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(1.8rem, 4.5vw, 2.4rem);
  line-height: 1.6;
  font-variant-numeric: lining-nums;
  font-feature-settings: "lnum" 1;
  color: var(--ink);
}

  .reading__content p {
    margin: 0 0 1.15em;
  }

  .reading__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .reading__edit,
  .reading__delete {
    font: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    transition:
      color 180ms ease,
      opacity 180ms ease,
      transform 180ms ease;
  }

  .reading__edit {
    padding: 0.85rem 1.2rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper-light);
    text-decoration: none;
  }

  .reading__delete {
    padding: 0.85rem 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    color: #8b3f38;
  }

  .reading__edit:hover,
  .reading__delete:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .reading__delete:hover {
    border-bottom-color: currentColor;
  }

  .reading__delete:disabled,
  .confirm-delete-button:disabled {
    cursor: wait;
    opacity: 0.6;
  }

  .delete-dialog {
    width: min(calc(100% - 2rem), 470px);
    padding: 0;
    border: 1px solid var(--line);
    background: var(--paper-light);
    color: var(--ink);
    box-shadow: 0 24px 70px rgba(41, 36, 30, 0.25);
  }

  .delete-dialog::backdrop {
    background: rgba(41, 36, 30, 0.58);
    backdrop-filter: blur(3px);
  }

  .delete-dialog__header {
    padding: clamp(1.7rem, 6vw, 2.4rem) clamp(2rem, 7vw, 3rem);
    background:
      linear-gradient(
        135deg,
        rgba(139, 63, 56, 0.98),
        rgba(112, 48, 43, 0.98)
      );
    color: #fffaf4;
  }

  .delete-dialog__content {
    padding: clamp(1.8rem, 6vw, 2.6rem) clamp(2rem, 7vw, 3rem);
  }

  .delete-dialog__label {
    margin: 0 0 0.7rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 250, 244, 0.72);
  }

  .delete-dialog h2 {
    margin: 0;
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.2rem, 7vw, 3.3rem);
    font-weight: 500;
    line-height: 1;
    color: #fffaf4;
  }

  .delete-dialog__text {
    margin: 0;
    line-height: 1.65;
    color: var(--muted);
  }

  .delete-dialog__actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.8rem;
    margin-top: 2.2rem;
  }

  .cancel-button,
  .confirm-delete-button {
    padding: 0.85rem 1.2rem;
    font: inherit;
    cursor: pointer;
  }

  .cancel-button {
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
  }

  .confirm-delete-button {
    border: 1px solid #8b3f38;
    background: #8b3f38;
    color: white;
  }

  .reading__footer {
    margin-top: clamp(6rem, 14vw, 10rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .reading__footer a {
    font-size: 0.95rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .reading__footer a:hover {
    color: var(--ink);
  }

  @media (max-width: 560px) {
    .reading {
      padding-top: 1.5rem;
    }

    .reading__header {
      align-items: flex-start;
    }

    .reading__label {
      text-align: right;
    }

    .reading__page {
      margin-top: 4rem;
    }

    .reading__divider {
      margin-bottom: 3.5rem;
    }

    .reading__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .reading__edit,
    .reading__delete {
      width: 100%;
      text-align: center;
    }

    .reading__delete {
      padding: 0.9rem;
    }

    .delete-dialog__actions {
      flex-direction: column-reverse;
    }

    .cancel-button,
    .confirm-delete-button {
      width: 100%;
    }
  }
</style>