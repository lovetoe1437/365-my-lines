---
import AppLayout from "../../../layouts/AppLayout.astro";
import DeleteConfirmDialog from "../../../components/DeleteConfirmDialog.astro";
import { env } from "cloudflare:workers";
import { getPage } from "../../../lib/db/pages";
import { formatLongDate } from "../../../lib/ui/date";
import BookOrnament from "../../../components/book/BookOrnament.astro";

export const prerender = false;

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.redirect("/book");

const page = await getPage(env.DB, id);
if (!page) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const date = formatLongDate(`${page.entry_date}T00:00:00`);
---

<AppLayout title={`Редактирование — ${page.title}`} class="diary-editor-page">
  <div class="editor-shell">
    <a class="editor-back" href={`/pages/${page.id}`}>← Вернуться к странице</a>

    <form class="paper" id="edit-form" novalidate>
      <header class="paper__header">
        <BookOrnament />
        <p class="paper__eyebrow">Личный дневник · редактирование</p>
        <label class="paper__date-field">
          <span>Дата записи</span>
          <input class="paper__date" id="entryDate" name="entryDate" type="date" value={page.entry_date} aria-label={`Дата записи: ${date}`} required />
        </label>
      </header>

      <input class="paper__title" id="title" name="title" value={page.title} maxlength="160" required />

      <div class="paper__ornament" aria-hidden="true"><span></span><b>✦</b><span></span></div>

      <textarea class="paper__content" id="content" name="content" required>{page.content}</textarea>

      <footer class="paper__footer">
        <p class="draft-indicator" id="draft-status" data-state="idle">Черновик готов</p>
        <p><span id="character-count">0</span> знаков</p>
      </footer>

      <p class="paper__message" id="form-message" aria-live="polite"></p>

      <div class="editor-actions">
        <button id="open-delete-dialog" class="editor-actions__delete" type="button">Удалить</button>
        <div class="editor-actions__right">
          <a class="editor-actions__cancel" href={`/pages/${page.id}`}>Отмена</a>
          <button id="save-button" class="editor-actions__save" type="submit">Сохранить изменения</button>
        </div>
      </div>
    </form>
  </div>
  <DeleteConfirmDialog
    title="Удалить эту запись?"
    message="Она исчезнет из дневника навсегда. Это действие нельзя отменить."
    confirmLabel="Удалить запись"
  />
</AppLayout>

<script define:vars={{ id }}>
  const DRAFT_KEY = `365-my-lines:edit-diary-page-${id}`;
  const form = document.getElementById("edit-form");
  const titleInput = document.getElementById("title");
  const contentInput = document.getElementById("content");
  const dateInput = document.getElementById("entryDate");
  const saveButton = document.getElementById("save-button");
  const message = document.getElementById("form-message");
  const status = document.getElementById("draft-status");
  const count = document.getElementById("character-count");
  const dialog = document.getElementById("delete-dialog");
  const openDelete = document.getElementById("open-delete-dialog");
  const cancelDelete = document.getElementById("cancel-delete");
  const confirmDelete = document.getElementById("confirm-delete");
  let saveTimer;

  const updateCount = () => {
    if (count && contentInput instanceof HTMLTextAreaElement) count.textContent = String(contentInput.value.length);
  };

  const redirectAfterExpiredSession = (response, result) => {
    if (response.status !== 401) return false;
    if (message) message.textContent = result.message ?? "Сессия завершилась. Войдите снова.";
    if (saveButton instanceof HTMLButtonElement) {
      saveButton.disabled = false;
      saveButton.textContent = "Сохранить изменения";
    }
    window.showAppDialog?.({
      eyebrow: "Доступ к редактору",
      title: "Сессия завершилась",
      message: result.message ?? "Для продолжения необходимо снова войти.",
      actionLabel: "Войти",
      actionHref: "/login",
    });
    return true;
  };

  const setDraftStatus = (text, state) => {
    if (!status) return;
    status.textContent = text;
    status.dataset.state = state;
  };

  const saveDraft = () => {
    if (!(titleInput instanceof HTMLInputElement) || !(contentInput instanceof HTMLTextAreaElement) || !(dateInput instanceof HTMLInputElement)) return;
    localStorage.setItem(DRAFT_KEY, JSON.stringify({ title: titleInput.value, content: contentInput.value, entryDate: dateInput.value }));
    setDraftStatus("Черновик сохранён", "saved");
  };

  const scheduleDraft = () => {
    setDraftStatus("Сохраняем черновик…", "saving");
    window.clearTimeout(saveTimer);
    saveTimer = window.setTimeout(saveDraft, 500);
  };

  try {
    const stored = localStorage.getItem(DRAFT_KEY);
    if (stored && titleInput instanceof HTMLInputElement && contentInput instanceof HTMLTextAreaElement && dateInput instanceof HTMLInputElement) {
      const draft = JSON.parse(stored);
      if (draft.title !== titleInput.value || draft.content !== contentInput.value || draft.entryDate !== dateInput.value) {
        titleInput.value = draft.title ?? titleInput.value;
        contentInput.value = draft.content ?? contentInput.value;
        dateInput.value = draft.entryDate ?? dateInput.value;
        setDraftStatus("Несохранённый черновик восстановлен", "restored");
      }
    }
  } catch { localStorage.removeItem(DRAFT_KEY); }

  titleInput?.addEventListener("input", scheduleDraft);
  dateInput?.addEventListener("input", scheduleDraft);
  contentInput?.addEventListener("input", () => { updateCount(); scheduleDraft(); });
  updateCount();

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(titleInput instanceof HTMLInputElement) || !(contentInput instanceof HTMLTextAreaElement) || !(dateInput instanceof HTMLInputElement) || !(saveButton instanceof HTMLButtonElement)) return;

    if (!titleInput.value.trim() || !contentInput.value.trim() || !dateInput.value) {
      if (message) message.textContent = "Дата, название и текст страницы не могут быть пустыми.";
      return;
    }

    saveButton.disabled = true;
    saveButton.textContent = "Сохраняем…";

    try {
      const data = new FormData();
      data.set("title", titleInput.value);
      data.set("content", contentInput.value);
      data.set("entryDate", dateInput.value);
      const response = await fetch(`/api/pages/${id}`, { method: "PUT", body: data });
      const result = await response.json();
      if (redirectAfterExpiredSession(response, result)) return;
      if (!response.ok || !result.ok) throw new Error(result.message ?? "Не удалось сохранить изменения.");
      localStorage.removeItem(DRAFT_KEY);
      saveButton.textContent = "Сохранено ✓";
      setDraftStatus("Изменения сохранены", "saved");
      window.setAppToastForNextPage?.({ tone: "success", title: "Изменения сохранены", message: "Запись обновлена и опубликована." });
      document.body.classList.add("is-leaving");
      window.setTimeout(() => { window.location.href = `/pages/${id}`; }, 400);
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : "Не удалось сохранить изменения.";
      if (message) message.textContent = errorMessage;
      window.showAppToast?.({ tone: "error", title: "Не удалось сохранить", message: errorMessage });
      saveButton.disabled = false;
      saveButton.textContent = "Сохранить изменения";
    }
  });

  openDelete?.addEventListener("click", () => dialog instanceof HTMLDialogElement && dialog.showModal());
  cancelDelete?.addEventListener("click", () => dialog instanceof HTMLDialogElement && dialog.close());
  dialog?.addEventListener("click", (event) => { if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close(); });

  confirmDelete?.addEventListener("click", async () => {
    if (!(confirmDelete instanceof HTMLButtonElement)) return;
    confirmDelete.disabled = true;
    confirmDelete.textContent = "Удаляем…";
    try {
      const response = await fetch(`/api/pages/${id}`, { method: "DELETE" });
      const result = await response.json();
      if (response.status === 401) {
        confirmDelete.disabled = false;
        confirmDelete.textContent = "Удалить запись";
        if (dialog instanceof HTMLDialogElement) dialog.close();
        window.showAppDialog?.({ eyebrow: "Доступ к редактору", title: "Сессия завершилась", message: result.message ?? "Для продолжения необходимо снова войти.", actionLabel: "Войти", actionHref: "/login" });
        return;
      }
      if (!response.ok || !result.ok) throw new Error(result.message ?? "Не удалось удалить страницу.");
      localStorage.removeItem(DRAFT_KEY);
      window.setAppToastForNextPage?.({ tone: "success", title: "Запись удалена", message: "Она больше не отображается в дневнике." });
      window.location.href = "/book";
    } catch (error) {
      const notFound = error instanceof Error && /не существует|не найдена|удалена/i.test(error.message);
      window.showAppDialog?.({
        eyebrow: notFound ? "Запись была удалена" : "Не удалось удалить",
        title: notFound ? "Запись больше не существует" : "Что-то пошло не так",
        message: error instanceof Error ? error.message : "Не удалось удалить страницу.",
        actionLabel: notFound ? "Вернуться в дневник" : "Закрыть",
        actionHref: notFound ? "/book" : "",
      });
      confirmDelete.disabled = false;
      confirmDelete.textContent = "Удалить запись";
    }
  });
</script>

<style>
  :global(.book-editor-page) { background: var(--paper); }
  :global(body.is-leaving) { opacity: 0; transition: opacity 400ms ease; }
  .editor-shell { width: min(100%, 980px); margin: 0 auto; padding: 2.2rem 1.5rem 6rem; }
  .editor-back { color: var(--muted); text-decoration: none; transition: color 180ms ease; }
  .editor-back:hover { color: var(--ink); }
  .paper { width: min(100%, 780px); margin: 3rem auto 0; padding: clamp(2.5rem,7vw,5.5rem) clamp(1.5rem,7vw,5.5rem) 2.2rem; background: rgba(251,248,242,.58); border: 1px solid rgba(58,47,36,.09); box-shadow: 0 24px 70px rgba(52,41,29,.06); }
  .paper__header { text-align: center; }
  .paper__header :global(.book-ornament){width:3rem;margin:0 auto 1.35rem}
  .paper__eyebrow { margin: 0 0 .65rem; font-size: .68rem; letter-spacing: .24em; text-transform: uppercase; color: var(--muted); }
  .paper__date-field{display:grid;justify-items:center;gap:.4rem}.paper__date-field span{color:var(--muted);font-size:.6rem;letter-spacing:.18em;text-transform:uppercase}.paper__date{width:auto;padding:.18rem .35rem;border:0;border-bottom:1px solid transparent;outline:0;background:transparent;color:var(--accent);font-family:var(--font-heading);font-size:1rem;text-align:center;cursor:pointer;transition:border-color 180ms ease}.paper__date:hover,.paper__date:focus{border-bottom-color:var(--line)}
  .paper__title { display:block; width:100%; margin:clamp(2.8rem,7vw,4.5rem) 0 1.8rem; padding:0; border:0; outline:0; background:transparent; text-align:center; font-family:"Cormorant Garamond",serif; font-size:clamp(2.7rem,8vw,5rem); font-weight:500; line-height:.98; color:var(--ink); }
  .paper__ornament { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:1rem; width:min(100%,460px); margin:0 auto clamp(3rem,7vw,5rem); color:var(--accent); }
  .paper__ornament span { height:1px; background:var(--line); } .paper__ornament b { font-size:.68rem; font-weight:400; }
  .paper__content { display:block; width:100%; height:clamp(360px,52vh,620px); min-height:360px; max-height:620px; padding:0 .75rem 0 0; overflow-y:auto; overflow-x:hidden; overscroll-behavior:contain; scrollbar-gutter:stable; resize:none; border:0; outline:0; background:transparent; font:inherit; font-size:clamp(1.08rem,2.3vw,1.22rem); line-height:1.95; color:var(--ink); }
  .paper__footer { display:flex; justify-content:space-between; gap:1rem; margin-top:2.4rem; padding-top:1.1rem; border-top:1px solid var(--line); font-size:.76rem; color:var(--muted); }
  .paper__footer p { margin:0; } .paper__message { min-height:1.4rem; margin:1rem 0 0; text-align:center; color:#9a493f; }
  .draft-indicator{display:inline-flex;align-items:center;gap:.5rem}.draft-indicator::before{width:.42rem;height:.42rem;border-radius:50%;background:var(--muted);content:"";opacity:.55;transition:background 180ms ease,opacity 180ms ease,transform 180ms ease}.draft-indicator[data-state="saving"]::before{background:var(--accent);opacity:1;animation:draft-pulse 900ms ease-in-out infinite}.draft-indicator[data-state="saved"]::before{background:#61745c;opacity:1}.draft-indicator[data-state="restored"]::before{background:#a57b48;opacity:1}
  .editor-actions { display:flex; align-items:center; justify-content:space-between; gap:1.4rem; margin-top:1.5rem; }
  .editor-actions__right { display:flex; align-items:center; gap:1.4rem; }
  .editor-actions__cancel { color:var(--muted); text-decoration:none; }
  button { font:inherit; }
  .editor-actions__delete { padding:0; border:0; background:transparent; color:#9a493f; cursor:pointer; }
  .editor-actions__save { min-width:190px; padding:.9rem 1.45rem; border:1px solid var(--ink); background:var(--ink); color:var(--paper-light); cursor:pointer; transition:transform 180ms ease,opacity 180ms ease; }
  .editor-actions__save:hover:not(:disabled) { transform:translateY(-1px); } button:disabled { opacity:.68; cursor:default; }
  @keyframes draft-pulse{50%{transform:scale(1.55);opacity:.45}}
  @media(prefers-reduced-motion:reduce){.draft-indicator::before{animation:none!important}:global(body.is-leaving){transform:none}}
  @media(max-width:700px){ .editor-shell{padding:1.3rem .9rem 3rem}.paper{margin-top:1.5rem;padding:2.6rem 1.25rem 1.3rem;box-shadow:none}.paper__title{margin-top:2.8rem}.editor-actions{align-items:flex-end}.editor-actions__right{gap:.8rem}.editor-actions__save{min-width:0}.editor-actions__cancel{display:none} }
</style>
