---
import AppLayout from "../../layouts/AppLayout.astro";
import { env } from "cloudflare:workers";
import { getPage } from "../../lib/db/pages";

export const prerender = false;

const rawId = Astro.params.id;
const id = Number(rawId);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/book");
}

const page = await getPage(env.DB, id);

if (!page) {
  return new Response("Страница не найдена", {
    status: 404,
  });
}

const formatDate = (value: string) => {
  const date = new Date(value.replace(" ", "T") + "Z");

  return new Intl.DateTimeFormat("ru-RU", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
};
---

<AppLayout
  title={`${page.title} — 365 моих строк`}
  description={page.content.slice(0, 150)}
  class="reading-page"
>
  <main class="reading">
    <header class="reading__header">
      <a class="reading__back" href="/book">
        ← Вернуться в книгу
      </a>

      <p class="reading__label">Личный дневник</p>
    </header>

    <article class="reading__page">
      <time class="reading__date" datetime={page.created_at}>
        {formatDate(page.created_at)}
      </time>

      <h1 class="reading__title">{page.title}</h1>

      <div class="reading__divider" aria-hidden="true">
        <span></span>
        <span class="reading__ornament">✦</span>
        <span></span>
      </div>

      <div class="reading__content">
        {
          page.content.split(/\r?\n/).map((paragraph) =>
            paragraph.trim() ? <p>{paragraph}</p> : <br />
          )
        }
      </div>
    </article>

    <footer class="reading__footer">
      <a href="/book">← Вернуться к другим страницам</a>
    </footer>
  </main>
</AppLayout>

<style>
  :global(.reading-page) {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at top,
        rgba(255, 255, 255, 0.58),
        transparent 42%
      ),
      var(--paper);
  }

  .reading {
    width: min(100%, 760px);
    min-height: 100vh;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .reading__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .reading__back {
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .reading__back:hover {
    color: var(--ink);
  }

  .reading__label {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .reading__page {
    margin-top: clamp(5rem, 10vw, 8rem);
  }

  .reading__date {
    display: block;
    font-size: 0.9rem;
    color: var(--muted);
  }

.reading__title {
  margin: 1.1rem 0 0;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(3.5rem, 9vw, 6.2rem);
  font-weight: 500;
  line-height: 0.98;
  letter-spacing: -0.02em;
  font-variant-numeric: lining-nums;
  font-feature-settings: "lnum" 1;
  color: var(--ink);
}

  .reading__divider {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    width: min(100%, 420px);
    margin: 2.5rem 0 3.5rem;
    color: var(--accent);
  }

.reading__divider span:not(.reading__ornament) {
  height: 1px;
  background: rgba(58, 47, 36, 0.28);
}

  .reading__ornament {
    font-size: 0.75rem;
  }

.reading__content {
  max-width: 680px;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(1.8rem, 4.5vw, 2.4rem);
  line-height: 1.6;
  font-variant-numeric: lining-nums;
  font-feature-settings: "lnum" 1;
  color: var(--ink);
}

  .reading__content p {
    margin: 0 0 1.15em;
  }

  .reading__footer {
    margin-top: clamp(6rem, 14vw, 10rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .reading__footer a {
    font-size: 0.95rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .reading__footer a:hover {
    color: var(--ink);
  }

  @media (max-width: 560px) {
    .reading {
      padding-top: 1.5rem;
    }

    .reading__header {
      align-items: flex-start;
    }

    .reading__label {
      text-align: right;
    }

    .reading__page {
      margin-top: 4rem;
    }

    .reading__divider {
      margin-bottom: 3.5rem;
    }
  }
</style>