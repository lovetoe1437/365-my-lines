---
import AppLayout from "../../layouts/AppLayout.astro";
import DiaryReadingHeader from "../../components/reading/DiaryReadingHeader.astro";
import ReadingNavigation from "../../components/reading/ReadingNavigation.astro";
import EntryImages from "../../components/reading/EntryImages.astro";
import DeleteConfirmDialog from "../../components/DeleteConfirmDialog.astro";
import { env } from "cloudflare:workers";
import { getPage, getPageNavigation } from "../../lib/db/pages";
import { formatLongDate } from "../../lib/ui/date";
import { getEntryImages } from "../../lib/db/entry-images";

export const prerender = false;

const rawId = Astro.params.id;
const id = Number(rawId);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/book");
}

const page = await getPage(env.DB, id);

if (!page) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const [navigation, images] = await Promise.all([
  getPageNavigation(env.DB, id),
  getEntryImages(env.DB, { kind: "diary", id }),
]);
const imagesBefore = images.filter((image) => image.placement === "before");
const imagesAfter = images.filter((image) => image.placement === "after");
const pageNumber = String(navigation.position).padStart(3, "0");
const previousHref = navigation.previous
  ? `/pages/${navigation.previous.id}`
  : null;
const nextHref = navigation.next ? `/pages/${navigation.next.id}` : null;


---

<AppLayout
  title={page.title}
  description={page.content.slice(0, 150)}
  class="reading-page"
>
  <div class="reading">
    <DiaryReadingHeader />

    <article class="reading__page">
      <time class="reading__date" datetime={page.entry_date}>
        {formatLongDate(`${page.entry_date}T00:00:00`)}
      </time>

      <h1 class="reading__title">{page.title}</h1>

      <div class="reading__divider" aria-hidden="true">
        <span></span>
        <span class="reading__ornament">✦</span>
        <span></span>
      </div>

      <EntryImages images={imagesBefore} placement="before" />

      <div class="reading__content">
        {
          page.content.split(/\r?\n/).map((paragraph) =>
            paragraph.trim() ? <p>{paragraph}</p> : <br />
          )
        }
      </div>

      <EntryImages images={imagesAfter} placement="after" />

      <div class="reading__actions">
        <a class="reading__edit" href={`/pages/${page.id}/edit`}>
          Редактировать
        </a>

        <button
          id="open-delete-dialog"
          class="reading__delete"
          type="button"
        >
          Удалить
        </button>
      </div>
    </article>

    <ReadingNavigation
      variant="diary"
      previousHref={previousHref}
      previousTitle={navigation.previous?.title}
      nextHref={nextHref}
      nextTitle={navigation.next?.title}
      currentNumber={navigation.position}
      total={navigation.total}
      indexHref="/book"
    />
  </div>

  <DeleteConfirmDialog
    title="Удалить запись?"
    message={"Эта страница будет удалена навсегда.\nВосстановить её после удаления\nбудет невозможно."}
    confirmLabel="Удалить"
  />

</AppLayout>

<script define:vars={{ id, previousHref, nextHref }}>
  const deleteDialog = document.getElementById("delete-dialog");
  const openDeleteDialogButton = document.getElementById(
    "open-delete-dialog"
  );
  const cancelDeleteButton = document.getElementById("cancel-delete");
  const closeDeleteDialogButton = document.getElementById(
    "close-delete-dialog"
  );
  const confirmDeleteButton = document.getElementById("confirm-delete");

  openDeleteDialogButton?.addEventListener("click", () => {
    if (deleteDialog instanceof HTMLDialogElement) {
      deleteDialog.showModal();
    }
  });

  const closeDeleteDialog = () => {
    if (deleteDialog instanceof HTMLDialogElement) {
      deleteDialog.close();
    }
  };

  cancelDeleteButton?.addEventListener("click", closeDeleteDialog);
  closeDeleteDialogButton?.addEventListener("click", closeDeleteDialog);

  deleteDialog?.addEventListener("click", (event) => {
    if (
      deleteDialog instanceof HTMLDialogElement &&
      event.target === deleteDialog
    ) {
      deleteDialog.close();
    }
  });

  confirmDeleteButton?.addEventListener("click", async () => {
    if (!(confirmDeleteButton instanceof HTMLButtonElement)) {
      return;
    }

    confirmDeleteButton.disabled = true;
    confirmDeleteButton.textContent = "Удаляем…";

    try {
      const response = await fetch(`/api/pages/${id}`, {
        method: "DELETE",
      });

      const result = await response.json();

      if (response.status === 401) {
        window.showAppDialog?.({
          eyebrow: "Доступ к редактору",
          title: "Сессия завершилась",
          message: result.message ?? "Для продолжения необходимо снова войти.",
          actionLabel: "Войти",
          actionHref: "/login",
        });
        return;
      }

      if (response.ok && result.ok) {
        window.setAppToastForNextPage?.({ tone: "success", title: "Запись удалена", message: "Она больше не отображается в дневнике." });
        window.location.href = "/book";
        return;
      }

      window.showAppDialog?.({
        eyebrow: response.status === 404 ? "Запись была удалена" : "Не удалось удалить",
        title: response.status === 404 ? "Запись больше не существует" : "Что-то пошло не так",
        message: result.message ?? "Не удалось удалить запись. Попробуй ещё раз.",
        actionLabel: response.status === 404 ? "Вернуться в дневник" : "Закрыть",
        actionHref: response.status === 404 ? "/book" : "",
      });
    } catch (error) {
      console.error("Не удалось удалить запись:", error);
      window.showAppDialog?.({
        eyebrow: "Нет соединения",
        title: "Не удалось связаться с сайтом",
        message: "Проверь подключение к интернету и попробуй ещё раз.",
        actionLabel: "Закрыть",
      });
    } finally {
      confirmDeleteButton.disabled = false;
      confirmDeleteButton.textContent = "Удалить";
    }
  });

  const navigateWithTransition = (href, isPageTurn = false) => {
    if (
      !href ||
      document.body.classList.contains("is-turning-page") ||
      document.body.classList.contains("diary-page-transition")
    ) {
      return;
    }

    document.body.classList.add(
      isPageTurn ? "is-turning-page" : "diary-page-transition",
    );
    window.setTimeout(() => {
      window.location.href = href;
    }, isPageTurn ? 170 : 360);
  };

  document.querySelectorAll('a[href^="/pages/"], a[href="/book"]').forEach((link) => {
    link.addEventListener("click", (event) => {
      if (!(link instanceof HTMLAnchorElement)) return;
      if (
        event.defaultPrevented ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        link.target === "_blank"
      ) {
        return;
      }

      event.preventDefault();
      navigateWithTransition(
        link.href,
        link.classList.contains("page-turner__link"),
      );
    });
  });

  document.addEventListener("keydown", (event) => {
    const target = event.target;
    const isTyping =
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      (target instanceof HTMLElement && target.isContentEditable);

    if (isTyping || event.metaKey || event.ctrlKey || event.altKey) return;

    if (event.key === "ArrowLeft" && previousHref) {
      event.preventDefault();
      navigateWithTransition(previousHref, true);
    }

    if (event.key === "ArrowRight" && nextHref) {
      event.preventDefault();
      navigateWithTransition(nextHref, true);
    }
  });

  let touchStartX = 0;
  let touchStartY = 0;
  let touchStartedOnInteractive = false;

  document.addEventListener(
    "touchstart",
    (event) => {
      const touch = event.changedTouches[0];
      touchStartX = touch.clientX;
      touchStartY = touch.clientY;
      touchStartedOnInteractive =
        event.target instanceof Element &&
        Boolean(
          event.target.closest(
            "a, button, input, textarea, select, dialog, [contenteditable]",
          ),
        );
    },
    { passive: true },
  );

  document.addEventListener(
    "touchend",
    (event) => {
      if (touchStartedOnInteractive) return;

      const touch = event.changedTouches[0];
      const deltaX = touch.clientX - touchStartX;
      const deltaY = touch.clientY - touchStartY;

      if (Math.abs(deltaX) < 70 || Math.abs(deltaX) < Math.abs(deltaY) * 1.35) {
        return;
      }

      if (deltaX > 0 && previousHref) navigateWithTransition(previousHref, true);
      if (deltaX < 0 && nextHref) navigateWithTransition(nextHref, true);
    },
    { passive: true },
  );

</script>

<style>
  :global(body.diary-page-transition){opacity:0;transform:translateY(5px);transition:opacity 360ms ease,transform 360ms ease}

  :global(.reading-page) {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at top,
        rgba(255, 255, 255, 0.58),
        transparent 42%
      ),
      var(--paper);
  }

  .reading {
    width: min(100%, 760px);
    min-height: 100vh;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .reading__page {
    margin-top: clamp(5rem, 10vw, 8rem);
  }

  .reading__date {
    display: block;
    font-size: 0.9rem;
    color: var(--muted);
  }

.reading__title {
  margin: 1.1rem 0 0;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(3.5rem, 9vw, 6.2rem);
  font-weight: 500;
  line-height: 0.98;
  letter-spacing: -0.02em;
  font-variant-numeric: lining-nums;
  font-feature-settings: "lnum" 1;
  color: var(--ink);
}

  .reading__divider {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    width: min(100%, 420px);
    margin: 2.5rem 0 3.5rem;
    color: var(--accent);
  }

.reading__divider span:not(.reading__ornament) {
  height: 1px;
  background: rgba(58, 47, 36, 0.28);
}

  .reading__ornament {
    font-size: 0.75rem;
  }

.reading__content {
  max-width: 680px;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(1.35rem, 2.7vw, 1.75rem);
  line-height: 1.72;
  font-variant-numeric: lining-nums;
  font-feature-settings: "lnum" 1;
  color: var(--ink);
}

  .reading__content p {
    margin: 0 0 0.38em;
  }

  .reading__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .reading__edit,
  .reading__delete {
    font: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    transition:
      color 180ms ease,
      opacity 180ms ease,
      transform 180ms ease;
  }

  .reading__edit {
    padding: 0.85rem 1.2rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper-light);
    text-decoration: none;
  }

  .reading__delete {
    padding: 0.85rem 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    color: #8b3f38;
  }

  .reading__edit:hover,
  .reading__delete:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .reading__delete:hover {
    border-bottom-color: currentColor;
  }

  .reading__delete:disabled {
    cursor: wait;
    opacity: 0.6;
  }



  :global(body.is-turning-page) .reading {
    opacity: 0;
    transform: translateY(4px);
  }

  :global(body.reading-page) .reading {
    transition:
      opacity 170ms ease,
      transform 170ms ease;
  }

  @media (max-width: 560px) {
    .reading {
      padding-top: 1.5rem;
    }


    .reading__page {
      margin-top: 4rem;
    }

    .reading__divider {
      margin-bottom: 2.4rem;
    }

    .reading__content {
      font-size: 1.28rem;
      line-height: 1.68;
    }

    .reading__content p {
      margin-bottom: 0.32em;
    }

    .reading__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .reading__edit,
    .reading__delete {
      width: 100%;
      text-align: center;
    }

    .reading__delete {
      padding: 0.9rem;
    }

  }
</style>
