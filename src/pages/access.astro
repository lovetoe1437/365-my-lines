---
import AppLayout from "../layouts/AppLayout.astro";
import Button from "../components/ui/Button.astro";
import { safeInternalPath } from "../lib/auth/redirect";

const error = Astro.url.searchParams.get("error");
const next = safeInternalPath(Astro.url.searchParams.get("next"), Astro.url.origin);
const errorMessage = error === "wrong-password"
  ? "Неверный пароль. Попробуйте ещё раз."
  : error === "too-many-attempts"
    ? "Слишком много попыток. Подождите 10 минут и попробуйте снова."
  : error === "invalid"
    ? "Введите пароль."
    : null;
---

<AppLayout
  title="Вход в книгу"
  description="Вход в личную книгу «365 моих строк»."
  class="access-page"
  hideNavigation
  noindex
>
  <section class="access" aria-labelledby="access-title">
    <div class="access__card paper-surface">
      <svg class="access__heart" viewBox="0 0 64 64" aria-hidden="true">
        <path d="M32 52C26 46 13 37 13 24.5 13 17 17.5 12 23.5 12c4.2 0 7.2 2.5 8.5 6 1.4-3.5 4.7-6 8.8-6C47 12 51 17.1 51 24.2 51 35.4 40.7 44.7 32 52Z" />
      </svg>

      <header>
        <p class="access__eyebrow">Личная книга</p>
        <h1 id="access-title">365 моих строк</h1>
        <p class="access__lead">Введите пароль, чтобы открыть книгу.</p>
      </header>

      <form method="POST" action="/api/access">
        <input type="hidden" name="next" value={next} />
        <label for="password">Пароль</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          placeholder="Введите пароль"
          required
          autofocus
          maxlength="512"
          aria-describedby={errorMessage ? "access-error" : undefined}
          aria-invalid={errorMessage ? "true" : undefined}
        />
        {errorMessage && <p class="access__error" id="access-error" role="alert">{errorMessage}</p>}
        <Button type="submit" fullWidth>
          Открыть книгу <span aria-hidden="true">→</span>
        </Button>
      </form>

      <p class="access__note">Это личное пространство.</p>
    </div>
  </section>
</AppLayout>

<style>
  :global(.access-page .app-shell) { display: grid; place-items: center; min-height: 100svh; }
  .access { display: grid; place-items: center; width: 100%; min-height: 100svh; padding: 1.5rem; }
  .access__card { width: min(100%, 28rem); padding: clamp(2rem, 8vw, 3.4rem); text-align: center; }
  .access__heart { width: 3.2rem; margin-bottom: 1.1rem; color: var(--color-accent); fill: none; stroke: currentColor; stroke-width: 2.1; }
  .access__eyebrow { margin: 0 0 .7rem; color: var(--color-accent); font-size: var(--text-xs); font-weight: 600; letter-spacing: .18em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(2.45rem, 11vw, 3.8rem); letter-spacing: -.04em; }
  .access__lead { margin: 1rem auto 2rem; color: var(--color-muted); line-height: 1.6; }
  form { display: grid; gap: .8rem; text-align: left; }
  label { color: var(--color-muted); font-size: var(--text-sm); font-weight: 600; }
  input { width: 100%; min-height: 3.25rem; padding: .85rem 1rem; border: 1px solid var(--color-line); border-radius: var(--radius-md); outline: none; background: rgba(255,255,255,.28); color: var(--color-ink); }
  input:focus { border-color: var(--color-accent); box-shadow: 0 0 0 3px rgba(128,102,79,.12); }
  input[aria-invalid="true"] { border-color: #9a5147; }
  .access__error { margin: 0; padding: .65rem .8rem; border: 1px solid rgba(154,81,71,.2); border-radius: var(--radius-sm); background: rgba(154,81,71,.07); color: #82463f; font-size: var(--text-sm); line-height: 1.5; }
  .access__note { margin: 1.6rem 0 0; color: var(--color-muted); font-size: var(--text-xs); }
</style>
