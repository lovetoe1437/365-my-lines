---
import { env } from "cloudflare:workers";
import AppLayout from "../../layouts/AppLayout.astro";
import BookOrnament from "../../components/book/BookOrnament.astro";
import { getBookLines } from "../../lib/db/book-lines";
import { getUnspoken } from "../../lib/db/unspoken";
import { formatLongDate } from "../../lib/ui/date";

export const prerender = false;

const [records, unspoken] = await Promise.all([getBookLines(env.DB), getUnspoken(env.DB)]);
const lines = records.map((line) => ({
  href: `/lines/${line.number}`,
  number: line.number,
  title: line.title,
  date: new Date(`${line.line_date}T00:00:00`),
}));
---

<AppLayout
  title="Книга"
  description="Оглавление личной цифровой книги — 365 моих строк."
  class="book-index-page"
>
  <section class="book-contents" aria-labelledby="book-contents-title">
    <header class="book-contents__intro">
      <BookOrnament />

      <p class="book-contents__eyebrow">Первое издание</p>
      <h1 id="book-contents-title">Оглавление книги</h1>
      <p class="book-contents__lead">365 страниц нашей истории</p>
    </header>

    {
      lines.length > 0 ? (
        <ol class="book-contents__list">
          {lines.map((line, index) => (
            <li class="book-contents__item" style={`--entry-delay:${120 + index * 55}ms`}>
              <a
                class="book-contents__link"
                href={line.href}
                data-book-link
                aria-label={`Открыть страницу ${line.number}: ${line.title}`}
              >
                <span class="book-contents__number">
                  {line.number}
                </span>

                <span class="book-contents__copy">
                  <span class="book-contents__title">{line.title}</span>
                  <time datetime={line.date.toISOString()}>
                    {formatLongDate(line.date)}
                  </time>
                </span>

                <span class="book-contents__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <section class="book-contents__empty" aria-labelledby="empty-book-title">
          <p>Первая страница</p>
          <h2 id="empty-book-title">Книга пока хранит тишину.</h2>
          <span>
            Иногда история начинается не с большого события, а всего с одной строки.
          </span>
          <a href="/lines/write">Открыть первую страницу →</a>
        </section>
      )
    }

    {unspoken.visibility === "epilogue" && (
      <a class="book-epilogue" href="/unspoken?from=book" data-book-link aria-label={`Открыть эпилог: ${unspoken.title}`}>
        <span class="book-epilogue__number" aria-hidden="true">✦</span>
        <span class="book-epilogue__copy">
          <small>Эпилог</small>
          <strong>{unspoken.title}</strong>
        </span>
        <span class="book-epilogue__arrow" aria-hidden="true">→</span>
      </a>
    )}

    <footer class="book-contents__footer">
      <span aria-hidden="true"></span>
      <p>{lines.length ? `${lines.length} из 365 страниц написано` : "История ещё впереди"}</p>
      <span aria-hidden="true"></span>
    </footer>
  </section>

  <div class="page-opening" data-page-opening aria-hidden="true">
    <span class="page-opening__spinner" aria-hidden="true"></span>
    <p>Открываем страницу…</p>
  </div>

  <script>
    const overlay = document.querySelector<HTMLElement>("[data-page-opening]");
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-book-link]");

    links.forEach((link) => {
      link.addEventListener("click", (event) => {
        if (
          event.defaultPrevented ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey ||
          link.target === "_blank"
        ) {
          return;
        }

        event.preventDefault();
        overlay?.classList.add("is-visible");
        overlay?.setAttribute("aria-hidden", "false");

        window.setTimeout(() => {
          window.location.href = link.href;
        }, 360);
      });
    });
  </script>
</AppLayout>

<style>
  :global(body.book-index-page) {
    background:
      radial-gradient(circle at 50% -12%, rgba(255, 255, 255, 0.84), transparent 34rem),
      var(--paper);
  }

  .book-contents {
    width: min(calc(100% - 3rem), 900px);
    min-height: calc(100svh - 68px);
    margin: 0 auto;
    padding: clamp(4rem, 9vw, 7rem) 0 3rem;
  }

  .book-contents__intro {
    max-width: 42rem;
    margin: 0 auto clamp(2.8rem, 6vw, 4.5rem);
    text-align: center;
    animation: reveal 680ms ease both;
  }

  .book-contents__intro :global(.book-ornament) {
    width: 3.6rem;
    margin: 0 auto 1.7rem;
  }

  .book-contents__eyebrow {
    margin: 0 0 0.85rem;
    color: var(--accent);
    font-size: 0.66rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(3rem, 8vw, 5.25rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.035em;
  }

  .book-contents__lead {
    margin: 1rem 0 0;
    color: var(--muted);
    font-family: var(--font-heading);
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-style: italic;
    line-height: 1.5;
  }

  .book-contents__list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .book-contents__item {
    border-bottom: 1px solid var(--line);
    animation: reveal 560ms var(--entry-delay) ease both;
  }

  .book-contents__link {
    position: relative;
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) 2rem;
    align-items: center;
    gap: clamp(1rem, 3.5vw, 2.5rem);
    min-height: 6rem;
    padding: 1.2rem 1rem;
    color: var(--ink);
    text-decoration: none;
    transition:
      background var(--transition-fast),
      padding-left var(--transition-normal);
  }

  .book-contents__link::before {
    position: absolute;
    top: 50%;
    left: 0;
    width: 1px;
    height: 0;
    background: var(--accent);
    content: "";
    transform: translateY(-50%);
    transition: height var(--transition-normal);
  }

  .book-contents__link:hover {
    padding-left: 1.55rem;
    background: rgba(252, 248, 240, 0.56);
  }

  .book-contents__link:hover::before {
    height: 3rem;
  }

  .book-contents__number {
    color: var(--accent-dark);
    font-family: var(--font-heading);
    font-size: 1.16rem;
    font-variant-numeric: lining-nums tabular-nums;
    letter-spacing: 0.025em;
  }

  .book-contents__copy {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .book-contents__title {
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 500;
    line-height: 1.14;
    transition: color var(--transition-fast);
  }

  .book-contents__link:hover .book-contents__title {
    color: var(--accent-dark);
  }

  time {
    color: var(--muted);
    font-family: var(--font-heading);
    font-size: 0.9rem;
    text-transform: lowercase;
  }

  .book-contents__arrow {
    justify-self: end;
    color: var(--muted-soft);
    font-size: 1.05rem;
    transition:
      color var(--transition-fast),
      transform var(--transition-normal);
  }

  .book-contents__link:hover .book-contents__arrow {
    color: var(--accent);
    transform: translateX(5px);
  }

  .book-contents__empty {
    padding: clamp(4rem, 10vw, 7rem) 1rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    text-align: center;
  }

  .book-contents__empty p {
    margin: 0 0 1rem;
    color: var(--accent);
    font-size: 0.68rem;
    letter-spacing: 0.23em;
    text-transform: uppercase;
  }

  .book-contents__empty h2 {
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
  }

  .book-contents__empty span {
    display: block;
    max-width: 34rem;
    margin: 1.5rem auto 0;
    color: var(--muted);
    line-height: 1.8;
  }

  .book-contents__empty a {
    display: inline-block;
    margin-top: 2rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--line);
  }

  .book-epilogue {
    position: relative;
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) 2rem;
    align-items: center;
    gap: clamp(1rem, 3.5vw, 2.5rem);
    min-height: 6rem;
    padding: 1.2rem 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    animation: reveal 560ms ease both;
    transition: background var(--transition-fast), padding-left var(--transition-normal);
  }

  .book-epilogue::before {
    position: absolute;
    top: 50%;
    left: 0;
    width: 1px;
    height: 0;
    background: var(--accent);
    content: "";
    transform: translateY(-50%);
    transition: height var(--transition-normal);
  }

  .book-epilogue:hover {
    padding-left: 1.55rem;
    background: rgba(252, 248, 240, 0.56);
  }

  .book-epilogue:hover::before { height: 3rem; }
  .book-epilogue__number { color: var(--accent); font-size: .78rem; }
  .book-epilogue__copy { display: grid; gap: .28rem; min-width: 0; }
  .book-epilogue__copy small { color: var(--muted); font-family: var(--font-heading); font-size: .82rem; font-style: italic; }
  .book-epilogue__copy strong { font-family: var(--font-heading); font-size: clamp(1.35rem, 3vw, 1.75rem); font-weight: 500; line-height: 1.14; transition: color var(--transition-fast); }
  .book-epilogue:hover .book-epilogue__copy strong { color: var(--accent-dark); }
  .book-epilogue__arrow { justify-self: end; color: var(--muted-soft); font-size: 1.05rem; transition: color var(--transition-fast), transform var(--transition-normal); }
  .book-epilogue:hover .book-epilogue__arrow { color: var(--accent); transform: translateX(5px); }

  .book-contents__footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: 3rem;
    color: var(--muted);
    text-align: center;
  }

  .book-contents__footer span {
    height: 1px;
    background: var(--line);
  }

  .book-contents__footer p {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-style: italic;
  }

  .page-opening {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-content: center;
    gap: 1rem;
    background: rgba(43, 37, 31, 0.76);
    color: #fffaf2;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    backdrop-filter: blur(5px);
    transition:
      opacity 220ms ease,
      visibility 220ms ease;
  }

  .page-opening.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .page-opening__spinner {
    width: 2rem;
    height: 2rem;
    margin: 0 auto;
    border: 1px solid rgba(255, 250, 242, 0.32);
    border-top-color: #fffaf2;
    border-radius: 50%;
    animation: opening-spin 800ms linear infinite;
  }

  .page-opening p {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.15rem;
  }

  @keyframes opening-spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 700px) {
    .book-contents {
      width: min(calc(100% - 2rem), 900px);
      padding-top: 3rem;
    }

    .book-contents__intro {
      margin-bottom: 2.6rem;
    }

    .book-contents__intro :global(.book-ornament) {
      margin-bottom: 1.35rem;
    }

    h1 {
      font-size: clamp(2.6rem, 12vw, 3.7rem);
    }

    .book-contents__link {
      grid-template-columns: 2.7rem minmax(0, 1fr) 1.2rem;
      gap: 0.75rem;
      min-height: 5.35rem;
      padding: 1rem 0.35rem;
    }

    .book-contents__link:hover {
      padding-left: 0.65rem;
    }

    .book-contents__number {
      align-self: start;
      padding-top: 0.12rem;
      font-size: 0.92rem;
    }

    .book-contents__title {
      font-size: 1.18rem;
    }

    time {
      font-size: 0.74rem;
    }

    .book-contents__footer {
      margin-top: 2.4rem;
    }
  }

  @media (max-width: 640px) {
    .book-epilogue {
      grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
      gap: .8rem;
      padding-inline: 0;
    }
    .book-epilogue:hover { padding-left: .45rem; }
  }

</style>
