---
import { env } from "cloudflare:workers";
import AppLayout from "../../layouts/AppLayout.astro";
import BookReadingToolbar from "../../components/reading/BookReadingToolbar.astro";
import ReadingNavigation from "../../components/reading/ReadingNavigation.astro";
import {
  getBookLine,
  getBookLineByNumber,
  getBookLines,
} from "../../lib/db/book-lines";
import { formatLongDate } from "../../lib/ui/date";
import { getUnspoken } from "../../lib/db/unspoken";

export const prerender = false;

const raw = Astro.params.id ?? "";
let line = null;

if (raw.startsWith("d-")) {
  const dbId = Number(raw.slice(2));

  if (Number.isInteger(dbId) && dbId > 0) {
    line = await getBookLine(env.DB, dbId);
  }
} else {
  const number = Number(raw);

  if (Number.isInteger(number) && number > 0) {
    line = await getBookLineByNumber(env.DB, number);
  }
}

if (!line) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const [all, unspoken] = await Promise.all([
  getBookLines(env.DB),
  getUnspoken(env.DB),
]);
const index = all.findIndex((item) => item.id === line.id);
const prev = all[index - 1] ?? null;
const next = all[index + 1] ?? null;

const date = new Date(`${line.line_date}T00:00:00`);

const lineUrl = (number: number) =>
  `/lines/${String(number).padStart(3, "0")}`;

const epilogueEnabled = unspoken.visibility === "epilogue";
const nextDestination = next
  ? lineUrl(next.number)
  : epilogueEnabled
    ? "/unspoken?from=book"
    : "/lines";

const paragraphs = line.content
  .split(/\n\s*\n+/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<AppLayout
  title={line.title}
  description={line.title}
  class="reading-page"
  hideNavigation={true}
>
  <section class="reading-stage" aria-label={`Строка ${line.number}`}>
    <article class="book-sheet" data-book-sheet>
      <BookReadingToolbar editHref={`/lines/d-${line.id}/edit`} />

      <div class="page-content">
        <header class="page-heading">
          <div class="line-number" aria-label={`Строка ${line.number}`}>
            <span>{line.number}</span>
            <i aria-hidden="true"></i>
          </div>

          <h1>{line.title}</h1>

          <time datetime={date.toISOString()}>
            {formatLongDate(date)}
          </time>

          <div class="ornament" aria-hidden="true">
            <span></span>
            <b>✦</b>
            <span></span>
          </div>
        </header>

        <div
          class="prose"
          data-length={paragraphs.length <= 2 ? "short" : paragraphs.length >= 6 ? "long" : "regular"}
        >
          {paragraphs.map((paragraph, paragraphIndex) => (
            <p style={`--paragraph-index:${paragraphIndex}`}>{paragraph}</p>
          ))}
        </div>

        <div class="entry-ending" aria-hidden="true">
          <span></span>
          <b>•</b>
          <span></span>
        </div>
      </div>

      <ReadingNavigation
        variant="book"
        previousHref={prev ? lineUrl(prev.number) : null}
        previousTitle={prev ? `${prev.number}. ${prev.title}` : null}
        nextHref={next ? lineUrl(next.number) : null}
        nextTitle={next ? `${next.number}. ${next.title}` : null}
        currentNumber={line.number}
        total={365}
        indexHref="/lines"
        finalHref={epilogueEnabled ? "/unspoken" : null}
        finalEyebrow={epilogueEnabled ? "После последней страницы" : "Конец книги"}
        finalTitle={epilogueEnabled ? unspoken.title : "Все строки"}
      />
    </article>

  </section>
</AppLayout>

<script
  define:vars={{
    previousUrl: prev ? lineUrl(prev.number) : null,
    nextUrl: nextDestination,
  }}
>
  const sheet = document.querySelector("[data-book-sheet]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  let isLeaving = false;
  let touchStartX = 0;
  let touchStartY = 0;
  let touchStartedOnInteractive = false;

  const turnPage = (url, direction) => {
    if (!url || isLeaving) return;

    isLeaving = true;

    if (!sheet || reduceMotion.matches) {
      window.location.href = url;
      return;
    }

    sheet.classList.add(
      direction === "previous" ? "is-turning-back" : "is-turning-forward",
    );

    window.setTimeout(() => {
      window.location.href = url;
    }, 280);
  };

  document.addEventListener("click", (event) => {
    const link = event.target.closest("[data-turn]");
    if (!link) return;

    event.preventDefault();
    turnPage(link.href, link.dataset.turn);
  });

  document.addEventListener("keydown", (event) => {
    const target = event.target;

    if (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target instanceof HTMLSelectElement ||
      target?.isContentEditable
    ) {
      return;
    }

    if (event.key === "ArrowLeft" && previousUrl) {
      event.preventDefault();
      turnPage(previousUrl, "previous");
    }

    if (event.key === "ArrowRight" && nextUrl) {
      event.preventDefault();
      turnPage(nextUrl, "next");
    }
  });

  sheet?.addEventListener(
    "touchstart",
    (event) => {
      const touch = event.changedTouches[0];
      touchStartX = touch.clientX;
      touchStartY = touch.clientY;
      touchStartedOnInteractive =
        event.target instanceof Element &&
        Boolean(
          event.target.closest(
            "a, button, input, textarea, select, [contenteditable]",
          ),
        );
    },
    { passive: true },
  );

  sheet?.addEventListener(
    "touchend",
    (event) => {
      if (touchStartedOnInteractive) return;

      const touch = event.changedTouches[0];
      const deltaX = touch.clientX - touchStartX;
      const deltaY = touch.clientY - touchStartY;

      if (
        Math.abs(deltaX) < 65 ||
        Math.abs(deltaX) < Math.abs(deltaY) * 1.25
      ) {
        return;
      }

      if (deltaX > 0 && previousUrl) {
        turnPage(previousUrl, "previous");
      }

      if (deltaX < 0 && nextUrl) {
        turnPage(nextUrl, "next");
      }
    },
    { passive: true },
  );
</script>

<style>
  /**
   * Reading composition
   *
   * Keep the page calm: the toolbar recedes, the heading stays compact,
   * and the prose remains narrow enough to feel like a printed edition.
   */
  :global(body.reading-page) {
    min-width: 320px;
    background:
      radial-gradient(
        circle at 50% -8%,
        rgba(255, 255, 255, 0.92),
        transparent 35rem
      ),
      linear-gradient(135deg, #ede5d9 0%, var(--paper) 52%, #e9dfd1 100%);
  }

  :global(body.reading-page .app-shell) {
    width: 100%;
  }

  .reading-stage {
    width: min(100% - 1.5rem, 1440px);
    min-height: 100svh;
    margin-inline: auto;
    padding: clamp(0.75rem, 1.6vw, 1.35rem) 0;
    perspective: 1800px;
  }

  .book-sheet {
    position: relative;
    display: flex;
    min-height: calc(100svh - clamp(1.5rem, 3.2vw, 2.7rem));
    overflow: hidden;
    flex-direction: column;
    border: 1px solid rgba(76, 59, 42, 0.13);
    border-radius: 18px;
    background:
      linear-gradient(rgba(255, 252, 245, 0.72), rgba(255, 252, 245, 0.72)),
      repeating-radial-gradient(
        circle at 20% 30%,
        rgba(92, 65, 38, 0.035) 0 0.7px,
        transparent 0.8px 4px
      ),
      var(--paper-light);
    box-shadow:
      0 24px 58px rgba(52, 39, 27, 0.14),
      0 3px 10px rgba(52, 39, 27, 0.08),
      inset 0 1px rgba(255, 255, 255, 0.9);
    transform-origin: center;
    animation: page-arrival 720ms cubic-bezier(0.22, 1, 0.36, 1) both;
    transition:
      opacity 280ms ease,
      transform 280ms cubic-bezier(0.4, 0, 1, 1);
  }

  .book-sheet::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(96, 68, 39, 0.035),
        transparent 7%,
        transparent 93%,
        rgba(96, 68, 39, 0.025)
      );
    content: "";
    pointer-events: none;
  }

  .book-sheet.is-turning-forward {
    opacity: 0;
    transform: translateX(-2.5%) rotateY(-2.5deg) scale(0.995);
  }

  .book-sheet.is-turning-back {
    opacity: 0;
    transform: translateX(2.5%) rotateY(2.5deg) scale(0.995);
  }

  .page-content,
  .page-turner {
    position: relative;
    z-index: 1;
  }

  .page-content {
    display: flex;
    width: min(100%, 820px);
    flex: 1;
    flex-direction: column;
    margin-inline: auto;
    padding:
      clamp(0.4rem, 1.4vw, 1.15rem)
      clamp(1.5rem, 5vw, 4.25rem)
      clamp(3rem, 5.5vw, 4.8rem);
  }

  .page-heading {
    text-align: center;
  }

  .line-number {
    display: grid;
    justify-items: center;
    color: var(--ink);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.35rem;
    font-variant-numeric: lining-nums tabular-nums;
    line-height: 1;
    opacity: 0;
    animation: reveal-up 650ms 100ms ease forwards;
  }

  .line-number i {
    width: 38px;
    height: 1px;
    margin-top: 0.8rem;
    background: color-mix(in srgb, var(--accent) 72%, transparent);
  }

  .page-heading h1 {
    max-width: 15ch;
    margin: clamp(0.9rem, 2vw, 1.3rem) auto 0;
    color: #241f1a;
    font-family: var(--font-heading);
    font-size: clamp(2.55rem, 5.35vw, 4.35rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-wrap: balance;
    opacity: 0;
    animation: reveal-up 720ms 190ms ease forwards;
  }

  time {
    display: block;
    margin-top: clamp(1.35rem, 2.3vw, 1.7rem);
    color: var(--muted);
    font-family: var(--font-heading);
    font-size: clamp(0.95rem, 1.5vw, 1.08rem);
    opacity: 0;
    animation: reveal-up 650ms 290ms ease forwards;
  }

  .ornament {
    display: grid;
    width: min(100%, 112px);
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    margin: clamp(1.1rem, 2vw, 1.45rem) auto 0;
    color: var(--accent);
    opacity: 0;
    animation: reveal-up 650ms 380ms ease forwards;
  }

  .ornament span {
    height: 1px;
    background: var(--line);
  }

  .ornament b {
    font-size: 0.7rem;
    font-weight: 400;
  }

  .prose {
    width: min(100%, 62ch);
    margin: clamp(1.5rem, 3vw, 2.35rem) auto 0;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.55vw, 1.17rem);
    hyphens: auto;
    line-height: 1.9;
    overflow-wrap: break-word;
    text-align: left;
    text-wrap: pretty;
  }

  .prose p {
    margin: 0 0 1.62em;
    orphans: 3;
    white-space: pre-line;
    widows: 3;
    opacity: 0;
    animation: reveal-prose 700ms
      calc(480ms + var(--paragraph-index) * 85ms)
      ease forwards;
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  .prose[data-length="short"] {
    width: min(100%, 56ch);
    margin-top: clamp(1.9rem, 3.8vw, 2.8rem);
    font-size: clamp(1.09rem, 1.75vw, 1.23rem);
    line-height: 1.94;
  }

  .prose[data-length="long"] {
    width: min(100%, 64ch);
    font-size: clamp(1.01rem, 1.45vw, 1.12rem);
    line-height: 1.86;
  }

  .entry-ending {
    display: grid;
    width: min(100%, 76px);
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.55rem;
    margin: clamp(2.8rem, 6vw, 4.5rem) auto 0;
    color: color-mix(in srgb, var(--accent) 62%, transparent);
    opacity: 0;
    animation: reveal-up 620ms 560ms ease forwards;
  }

  .entry-ending span {
    height: 1px;
    background: currentColor;
  }

  .entry-ending b {
    font-size: 0.72rem;
    font-weight: 400;
  }

  .page-turner {
    display: grid;
    min-height: 82px;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    margin-top: auto;
    padding: 1.2rem clamp(1.35rem, 3.8vw, 3.4rem);
    border-top: 1px solid var(--line);
  }

  .turn {
    min-width: 0;
  }

  .turn > a,
  .turn-disabled {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    gap: 1rem;
    color: var(--ink);
    text-decoration: none;
  }

  .turn > a {
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .turn-prev > a:hover {
    color: var(--accent);
    transform: translateX(-4px);
  }

  .turn-next {
    text-align: right;
  }

  .turn-next > a {
    justify-content: flex-end;
  }

  .turn-next > a:hover {
    color: var(--accent);
    transform: translateX(4px);
  }

  .turn-disabled {
    color: var(--muted);
    opacity: 0.55;
  }

  .turn-copy {
    display: grid;
    min-width: 0;
  }

  .turn-copy small {
    margin-bottom: 0.22rem;
    color: var(--muted);
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .turn-copy strong {
    overflow: hidden;
    font-family: var(--font-heading);
    font-size: clamp(0.85rem, 1.4vw, 1rem);
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .page-counter {
    display: inline-flex;
    align-items: baseline;
    gap: 0.34rem;
    color: color-mix(in srgb, var(--ink) 86%, transparent);
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-variant-numeric: lining-nums tabular-nums;
    text-decoration: none;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .page-counter:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }

  .page-counter i {
    color: var(--muted);
    font-style: normal;
  }

  .counter-word {
    color: var(--muted);
  }

  .keyboard-hint {
    margin: 1rem 0 0;
    color: color-mix(in srgb, var(--muted) 78%, transparent);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-align: center;
  }

  @keyframes page-arrival {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.992);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes reveal-up {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes reveal-prose {
    from {
      opacity: 0;
      transform: translateY(7px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 700px) {
    :global(body.reading-page) {
      background: var(--paper-light);
    }

    .reading-stage {
      width: 100%;
      min-height: 100svh;
      padding: 0;
    }

    .book-sheet {
      min-height: calc(100svh - 68px);
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .page-content {
      padding:
        clamp(1.1rem, 4.5vw, 2rem)
        clamp(1.45rem, 7vw, 2.3rem)
        3.2rem;
    }

    .line-number {
      font-size: 1.25rem;
    }

    .page-heading h1 {
      margin-top: 0.95rem;
      font-size: clamp(2.45rem, 11vw, 3.55rem);
      line-height: 0.98;
    }

    time {
      margin-top: 1.2rem;
      font-size: 0.94rem;
    }

    .prose {
      width: 100%;
      margin-top: 1.55rem;
      font-size: clamp(1rem, 4.25vw, 1.09rem);
      hyphens: none;
      line-height: 1.86;
    }

    .prose[data-length="short"] {
      margin-top: 1.75rem;
      font-size: clamp(1.04rem, 4.65vw, 1.14rem);
      line-height: 1.88;
    }

    .prose[data-length="long"] {
      font-size: clamp(0.98rem, 4.05vw, 1.055rem);
      line-height: 1.82;
    }

    .entry-ending {
      margin-top: 3rem;
    }

    .page-turner {
      position: sticky;
      z-index: 5;
      bottom: 0;
      min-height: 66px;
      gap: 0.75rem;
      padding: 0.7rem 1rem max(0.7rem, env(safe-area-inset-bottom));
      border-top-color: color-mix(in srgb, var(--line) 82%, transparent);
      background: rgba(251, 248, 242, 0.94);
      box-shadow: 0 -10px 28px rgba(52, 39, 27, 0.055);
      backdrop-filter: blur(16px);
    }

    .turn-copy {
      display: none;
    }

    .turn > a,
    .turn-disabled {
      width: 44px;
      height: 44px;
      justify-content: center;
      border-radius: 999px;
    }

    .turn > a:hover {
      background: rgba(128, 102, 79, 0.07);
      transform: none;
    }

    .turn-next {
      display: flex;
      justify-content: flex-end;
    }

    .page-counter {
      gap: 0.4rem;
      font-size: 1.12rem;
    }

    .counter-word {
      display: none;
    }

    .counter-separator::before {
      content: "/";
    }

    .counter-separator {
      font-size: 0;
    }

    .counter-separator::before {
      font-size: 1.12rem;
    }

    .keyboard-hint {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .page-content {
      padding-inline: 1.25rem;
    }

    .page-heading h1 {
      font-size: clamp(2.55rem, 12.5vw, 3.35rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .book-sheet,
    .line-number,
    .page-heading h1,
    time,
    .ornament,
    .entry-ending,
    .prose p {
      animation: none;
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
