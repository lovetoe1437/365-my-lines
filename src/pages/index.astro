  .home-book small{position:absolute;bottom:13%;color:#d9c7b2;font-size:.55rem;letter-spacing:.24em;text-transform:uppercase}
  .home-book__ribbon{position:absolute;right:15%;bottom:-11%;width:17px;height:22%;background:#964438;clip-path:polygon(0 0,100% 0,100% 100%,50% 82%,0 100%)}
