  .home-hero__eyebrow,.home-section-label{margin:0;color:var(--accent);font-size:.67rem;letter-spacing:.24em;text-transform:uppercase}
  .home-hero h1{max-width:11ch;margin:1.2rem 0 0;font-size:clamp(4.4rem,7vw,6.6rem);font-weight:500;line-height:.82;letter-spacing:-.055em}
  .home-hero__lead{display:grid;gap:.05rem;margin:2rem 0 0;color:#5d5147;font-family:var(--font-heading);font-size:clamp(1.18rem,2.1vw,1.5rem);line-height:1.48}
  .home-hero__extra{margin:.35rem 0 0;color:var(--muted);font-size:.92rem;line-height:1.72}
  .home-hero__actions{display:flex;gap:1rem;margin-top:2.4rem}
  .home-button{display:inline-flex;align-items:center;justify-content:space-between;gap:2rem;min-width:182px;padding:1rem 1.25rem;border:1px solid var(--accent);font-size:.88rem;transition:transform var(--transition-normal),background var(--transition-fast),color var(--transition-fast),box-shadow var(--transition-normal)}
