---
import AppLayout from "../layouts/AppLayout.astro";
import BookOrnament from "../components/book/BookOrnament.astro";
import { env } from "cloudflare:workers";
import { getBookLines } from "../lib/db/book-lines";
import { getPages } from "../lib/db/pages";
import { findLatestByDate, formatLongDate } from "../lib/ui/date";

export const prerender = false;

const [bookLines, diaryPages] = await Promise.all([
  getBookLines(env.DB),
  getPages(env.DB),
]);

type LatestEntry =
  | {
      type: "book";
      id: number;
      title: string;
      content: string;
      displayDate: string;
      href: string;
    }
  | {
      type: "diary";
      id: number;
      title: string;
      content: string;
      displayDate: string;
      href: string;
    };

const latestEntryCandidates: LatestEntry[] = [
  ...bookLines.map((line) => ({
    type: "book" as const,
    id: line.id,
    title: line.title,
    content: line.content,
    displayDate: line.line_date,
    href: `/lines/d-${line.id}`,
  })),
  ...diaryPages.map((page) => ({
    type: "diary" as const,
    id: page.id,
    title: page.title,
    content: page.content,
    displayDate: page.entry_date,
    href: `/pages/${page.id}`,
  })),
];

const latestEntry = findLatestByDate(
  latestEntryCandidates,
  (entry) => entry.displayDate,
);

const latestUpdateLabel = latestEntry
  ? formatLongDate(latestEntry.displayDate)
  : "книга только начинается";

const createExcerpt = (content: string, limit = 105) => {
  const normalized = content.replace(/\s+/g, " ").trim();
  return normalized.length <= limit
    ? normalized
    : `${normalized.slice(0, limit).trim()}…`;
};

const diaryCountLabel = (count: number) => {
  const lastTwo = count % 100;
  const last = count % 10;
  if (lastTwo >= 11 && lastTwo <= 14) return `${count} записей`;
  if (last === 1) return `${count} запись`;
  if (last >= 2 && last <= 4) return `${count} записи`;
  return `${count} записей`;
};
---

<AppLayout
  title="365 моих строк"
  description="Личная цифровая книга — некоторые страницы невозможно написать вовремя."
  class="home-page"
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__glow" aria-hidden="true"></div>

    <div class="home-hero__copy">
      <p class="home-hero__eyebrow">Личная цифровая книга</p>
      <h1 id="home-title"><span class="home-title__number">365</span> <span class="home-title__words">моих строк</span></h1>
      <p class="home-hero__lead">
        <span>Некоторые страницы невозможно написать вовремя.</span>
        <span>Поэтому эта книга продолжается здесь.</span>
      </p>
      <p class="home-hero__extra">
        Здесь появляются новые мысли, новые страницы<br />
        и то, что невозможно сказать вслух.
      </p>

    </div>

    <div class="home-hero__controls">
      <div class="home-hero__actions">
        <a class="home-button home-button--primary" href="/lines">
          <span>Открыть книгу</span><span aria-hidden="true">→</span>
        </a>
        <a class="home-button home-button--secondary" href="/book">
          <span>Открыть дневник</span><span aria-hidden="true">→</span>
        </a>
      </div>

      <p class="home-hero__updated">
        <span aria-hidden="true">◷</span>
        Последнее обновление <i aria-hidden="true">•</i> {latestUpdateLabel}
      </p>
    </div>

    <a class="home-book" href="/lines" aria-label="Открыть книгу 365 моих строк">
      <span class="home-book__pages" aria-hidden="true"></span>
      <span class="home-book__cover">
        <span class="home-book__star" aria-hidden="true">✦</span>
        <strong>365</strong>
        <em>моих строк</em>
        <small>один день · одна мысль</small>
      </span>
      <span class="home-book__ribbon" aria-hidden="true"></span>
    </a>

    <img class="home-hero__flowers" src="/botanical-branch.svg" alt="" aria-hidden="true" />
    <img class="home-hero__flowers home-hero__flowers--ghost" src="/botanical-branch.svg" alt="" aria-hidden="true" />
  </section>

  <section class="home-content" aria-label="Продолжение книги">
    <BookOrnament />

    <div class="home-latest">
      <p class="home-section-label">Последняя запись <span aria-hidden="true">✎</span></p>

      {latestEntry ? (
        <a class="latest-entry" href={latestEntry.href}>
          <time class="latest-entry__date" datetime={latestEntry.displayDate}>
            <strong>{new Date(`${latestEntry.displayDate}T00:00:00`).getDate()}</strong>
            <span>{new Intl.DateTimeFormat("ru-RU", { month: "long" }).format(new Date(`${latestEntry.displayDate}T00:00:00`))}</span>
            <small>{new Date(`${latestEntry.displayDate}T00:00:00`).getFullYear()}</small>
          </time>
          <span class="latest-entry__copy">
            <strong>{latestEntry.title}</strong>
            <span>{createExcerpt(latestEntry.content)}</span>
          </span>
          <span class="latest-entry__link">
            {latestEntry.type === "book" ? "Читать страницу" : "Читать запись"}
            <b aria-hidden="true">→</b>
          </span>
        </a>
      ) : (
        <a class="latest-entry latest-entry--empty" href="/diary/write">
          <span class="latest-entry__copy">
            <strong>Первая запись ещё впереди</strong>
            <span>Иногда началом становится всего одна честная мысль.</span>
          </span>
          <span class="latest-entry__link">Написать <b aria-hidden="true">→</b></span>
        </a>
      )}
    </div>

    <div class="home-destinations">
      <a class="destination-card" href="/lines">
        <span class="destination-card__icon" aria-hidden="true">▤</span>
        <span class="destination-card__copy">
          <strong>Книга</strong>
          <span>{bookLines.length} из 365 страниц</span>
          <small>История, которая уже написана.<br />То, что навсегда останется здесь.</small>
        </span>
        <span class="destination-card__link">Перейти <b aria-hidden="true">→</b></span>
      </a>

      <a class="destination-card" href="/book">
        <span class="destination-card__icon destination-card__icon--quill" aria-hidden="true">⌁</span>
        <span class="destination-card__copy">
          <strong>Дневник</strong>
          <span>{diaryCountLabel(diaryPages.length)}</span>
          <small>Мысли, которые продолжают появляться.<br />Живой дневник наших дней.</small>
        </span>
        <span class="destination-card__link">Перейти <b aria-hidden="true">→</b></span>
      </a>
    </div>

    <footer class="home-footer">
      <BookOrnament />
      <p>© Всё, что не смог сказать вслух.</p>
    </footer>
  </section>

  <nav class="home-mobile-tabs" aria-label="Быстрая навигация">
    <a href="/lines"><span aria-hidden="true">▤</span><small>Книга</small></a>
    <a href="/book"><span aria-hidden="true">⌁</span><small>Дневник</small></a>
  </nav>
</AppLayout>

<style>
