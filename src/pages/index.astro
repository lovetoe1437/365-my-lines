  .home-book{position:relative;z-index:2;grid-column:2;grid-row:1 / 3;align-self:center;justify-self:center;width:min(31vw,365px);aspect-ratio:.715;filter:drop-shadow(0 28px 34px rgba(52,36,24,.17)) drop-shadow(-8px 10px 16px rgba(80,56,38,.055));transform:translate(1.3rem,-5px);animation:reveal 850ms 120ms ease both,floatBook 9s 1.1s ease-in-out infinite}
  .home-book__pages{position:absolute;inset:2.3% -3% -2.5% 3.2%;border-radius:2px 8px 8px 2px;background:repeating-linear-gradient(90deg,#d9cbb8 0 1px,#f8f1e7 1px 3px);transform:skewY(-1deg)}
  .home-book__cover{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,.14);background:linear-gradient(145deg,rgba(255,255,255,.08),transparent 34%),repeating-linear-gradient(92deg,rgba(255,255,255,.026) 0 1px,transparent 1px 4px),linear-gradient(145deg,#725b48,#523e30 64%,#403026);color:#f5ebde;box-shadow:inset 0 0 0 9px rgba(255,255,255,.025),inset 0 0 0 10px rgba(0,0,0,.14);text-align:center;transition:filter var(--transition-normal),transform var(--transition-slow)}
