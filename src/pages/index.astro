  .destination-card:hover{transform:translateY(-2px);background:rgba(255,252,246,.62);box-shadow:0 15px 30px rgba(67,45,29,.06)}
  .destination-card__icon{display:grid;place-items:center;width:58px;height:58px;border-radius:50%;background:rgba(155,119,82,.1);color:#74583f;font-family:var(--font-heading);font-size:1.8rem}.destination-card__icon--quill{font-size:2.3rem;transform:rotate(-12deg)}
  .destination-card__copy{display:grid;gap:.3rem}.destination-card__copy strong{font-family:var(--font-heading);font-size:1.65rem;font-weight:500}.destination-card__copy>span{font-family:var(--font-heading);font-size:.9rem}.destination-card__copy small{color:var(--muted);font-size:.73rem;line-height:1.62}
  .home-footer{display:grid;justify-items:center;gap:.8rem;margin-top:1.4rem;padding-top:1rem;color:var(--muted);text-align:center}.home-footer>:global(.book-ornament){width:3.8rem}.home-footer p{margin:0;font-family:var(--font-heading);font-size:.85rem}
  .home-mobile-tabs{display:none}

  @media(min-width:1200px){
