  .latest-entry__copy{display:grid;gap:.35rem;padding:1.25rem 1.4rem}.latest-entry__copy>strong{font-family:var(--font-heading);font-size:1.35rem;font-weight:500}.latest-entry__copy>span{color:var(--muted);font-size:.84rem;line-height:1.6}
  .latest-entry__link,.destination-card__link{display:flex;align-items:center;gap:.75rem;padding:1.25rem;color:#5c4a3c;font-family:var(--font-heading);font-size:.83rem;white-space:nowrap}.latest-entry__link b,.destination-card__link b{font-weight:400;transition:transform var(--transition-fast)}.latest-entry:hover b,.destination-card:hover b{transform:translateX(4px)}
