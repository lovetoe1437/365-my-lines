  .home-hero{position:relative;display:grid;grid-template-columns:minmax(0,1.02fr) minmax(340px,.98fr);grid-template-rows:auto auto;align-items:end;gap:clamp(2.5rem,5vw,5.5rem);width:min(calc(100% - 3rem),1240px);min-height:clamp(640px,calc(100svh - 68px),760px);margin:0 auto;padding:clamp(3.8rem,6vw,5.6rem) 0 3.2rem;border-bottom:1px solid var(--line);overflow:visible}
