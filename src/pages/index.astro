    .home-book{justify-self:start;margin-left:clamp(1rem,3vw,3rem)}
    .home-hero__flowers{right:clamp(-.5rem,1vw,.8rem);bottom:1rem}
  }
  @media(max-width:860px){.home-hero{grid-template-columns:1fr;grid-template-rows:auto auto auto;gap:2.25rem;min-height:auto;padding:4.6rem 0 3.6rem;text-align:center}.home-hero__copy{grid-column:1;grid-row:1;display:flex;flex-direction:column;align-items:center}.home-hero__controls{grid-column:1;grid-row:3;display:flex;flex-direction:column;align-items:center;width:100%}.home-hero h1{max-width:none;font-size:clamp(4.2rem,15vw,6.5rem)}.home-hero__lead{max-width:34rem}.home-hero__extra{display:none}.home-hero__actions{width:min(100%,430px);flex-direction:column}.home-button{width:100%}.home-book{grid-column:1;grid-row:2;width:min(58vw,330px);transform:translateY(-5px)}.home-hero__flowers{right:2%;bottom:8.15rem;z-index:4;width:170px;opacity:.84}.home-hero__flowers--ghost{left:10%;right:auto;bottom:7.4rem;width:92px}.home-hero__updated{margin-top:1.2rem}.home-content{padding-top:2.5rem}.home-destinations{grid-template-columns:1fr}.destination-card{max-width:800px;width:100%;margin:0 auto}}
  @media(max-width:640px){:global(body.home-page){padding-bottom:72px}.home-hero{width:100%;gap:1.25rem;padding:2.75rem 1.15rem 2.1rem;border-bottom:0}.home-hero h1{display:block;margin-top:1.05rem;line-height:1;letter-spacing:-.035em}.home-title__number{display:block;font-size:4.9rem;line-height:.78}.home-title__words{display:block;margin-top:.7rem;font-size:2rem;line-height:1;letter-spacing:.015em}.home-hero__eyebrow{font-size:.58rem}.home-hero__lead{width:min(100%,19rem);gap:.1rem;margin-top:1.25rem;font-size:1.02rem;line-height:1.42}.home-hero__lead span{display:block;max-width:100%;overflow-wrap:anywhere}.home-book{width:min(55vw,230px);margin-top:.2rem;transform:translateY(-3px)}.home-book strong{font-size:5rem}.home-book em{font-size:1.25rem}.home-hero__flowers{right:-.15rem;bottom:9.65rem;z-index:4;width:138px;opacity:.86}.home-hero__flowers--ghost{left:-1.1rem;right:auto;bottom:9.2rem;width:88px;opacity:.16;transform:scaleX(-1) rotate(4deg)}.home-hero__actions{margin-top:.15rem}.home-button{min-width:0;padding:.92rem 1.15rem}.home-hero__updated{font-size:.75rem;flex-wrap:wrap;justify-content:center}.home-content{width:100%;padding:1.5rem 1rem 1rem;border-top:1px solid var(--line)}.home-content>:global(.book-ornament){display:block;width:3.6rem;margin:0 auto 1.7rem}.home-latest{width:100%}.latest-entry{grid-template-columns:80px minmax(0,1fr);align-items:stretch}.latest-entry__date{grid-row:1/3}.latest-entry__copy{padding:1rem}.latest-entry__copy>strong{font-size:1.15rem}.latest-entry__copy>span{font-size:.76rem}.latest-entry__link{grid-column:2;padding:.1rem 1rem 1rem;justify-self:end}.latest-entry--empty{grid-template-columns:1fr}.latest-entry--empty .latest-entry__link{grid-column:1}.home-destinations{grid-template-columns:1fr 1fr;gap:.55rem}.destination-card{grid-template-columns:1fr;justify-items:center;min-height:135px;padding:1rem .45rem;text-align:center}.destination-card__icon{width:48px;height:48px;font-size:1.55rem}.destination-card__copy strong{font-size:1.15rem}.destination-card__copy>span,.destination-card__copy small,.destination-card__link{display:none}.home-footer{display:none}.home-mobile-tabs{position:fixed;right:0;bottom:0;left:0;z-index:40;display:grid;grid-template-columns:1fr 1fr;min-height:66px;border-top:1px solid var(--line);background:rgba(248,242,232,.94);backdrop-filter:blur(16px)}.home-mobile-tabs a{display:grid;place-items:center;align-content:center;gap:.1rem;border-right:1px solid var(--line);color:#59483b}.home-mobile-tabs a:last-child{border-right:0}.home-mobile-tabs span{font-family:var(--font-heading);font-size:1.45rem;line-height:1}.home-mobile-tabs small{font-family:var(--font-heading);font-size:.8rem}}
</style>
