---
import AppLayout from "../../layouts/AppLayout.astro";
import EditorActions from "../../components/editor/EditorActions.astro";
import EditorMeta from "../../components/editor/EditorMeta.astro";
import BookOrnament from "../../components/book/BookOrnament.astro";
import { formatDateInputValue } from "../../lib/ui/date";
import "../../styles/editor.css";

const isoToday = formatDateInputValue();
---

<AppLayout title="Новая запись" class="diary-editor-page">
  <div class="diary-writing">
    <header class="diary-writing__toolbar">
      <a href="/book">← Вернуться в дневник</a>
      <span class="draft-indicator" id="draft-status" data-state="idle">Черновик готов</span>
    </header>

    <form id="entry-form" class="diary-paper" novalidate>
      <div class="diary-paper__heading">
        <BookOrnament />
        <p>Личный дневник</p>
        <label class="diary-paper__date-label">
          <span>Дата записи</span>
          <input class="diary-paper__date" id="entryDate" name="entryDate" type="date" value={isoToday} required />
        </label>
        <input id="title" name="title" aria-label="Заголовок записи" placeholder="Название записи" maxlength="160" required />
        <div class="diary-paper__divider" aria-hidden="true"><span></span><b>✦</b><span></span></div>
      </div>

      <textarea id="content" name="content" aria-label="Текст записи" placeholder="Напиши то, что хочется сохранить…" required></textarea>

      <footer class="diary-paper__footer">
        <EditorMeta class="meta" itemTag="span" strongCount={true} />
        <p id="form-message" aria-live="polite"></p>
      </footer>

      <EditorActions class="actions" cancelHref="/book" saveLabel="Сохранить запись" />
    </form>
  </div>
</AppLayout>

<script>
  import { initEditor } from "../../lib/editor/createEditor";
  import { diarySavedMessages, diaryWritingPrompts } from "../../lib/editor/messages";
  import { formatDateInputValue } from "../../lib/ui/date";

  const dateInput = document.querySelector<HTMLInputElement>("#entryDate");
  if (dateInput) dateInput.value = formatDateInputValue();

  initEditor({
    storageKey: "365-my-lines:new-diary-entry",
    endpoint: "/api/pages",
    redirectTo: (id) => `/pages/${id}`,
    idleButtonLabel: "Сохранить запись",
    savedButtonLabel: "Запись сохранена",
    promptMessages: diaryWritingPrompts,
    successMessages: diarySavedMessages,
  });
</script>

<style>
  :global(body.diary-editor-page){background:radial-gradient(circle at 50% -10%,rgba(255,255,255,.9),transparent 35rem),linear-gradient(135deg,#ede4d7,var(--paper) 55%,#e8dccd)}
  .diary-writing{width:min(100% - 1.5rem,1120px);min-height:100svh;margin:0 auto;padding:clamp(.75rem,1.8vw,1.4rem) 0;perspective:1800px}
  .diary-writing__toolbar{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.65rem .8rem 1.1rem;color:var(--muted);font-family:var(--font-heading);font-size:.9rem}
  .diary-writing__toolbar a{transition:color var(--transition-fast),transform var(--transition-fast)}.diary-writing__toolbar a:hover{color:var(--ink);transform:translateX(-3px)}
  .diary-writing__toolbar span{font-size:.8rem;font-style:italic}
  .draft-indicator{display:inline-flex;align-items:center;gap:.5rem}.draft-indicator::before{width:.42rem;height:.42rem;border-radius:50%;background:var(--muted);content:"";opacity:.55;transition:background 180ms ease,opacity 180ms ease,transform 180ms ease}.draft-indicator[data-state="saving"]::before{background:var(--accent);opacity:1;animation:draft-pulse 900ms ease-in-out infinite}.draft-indicator[data-state="saved"]::before{background:#61745c;opacity:1}.draft-indicator[data-state="restored"]::before{background:#a57b48;opacity:1}
  :global(body.is-leaving){opacity:0;transform:translateY(5px);transition:opacity 420ms ease,transform 420ms ease}
  .diary-paper{position:relative;min-height:calc(100svh - 5rem);padding:clamp(3.5rem,8vw,6.5rem) clamp(1.35rem,8vw,7.5rem) 2rem;border:1px solid rgba(76,59,42,.13);border-radius:18px;background:linear-gradient(rgba(255,252,245,.76),rgba(255,252,245,.76)),repeating-radial-gradient(circle at 20% 30%,rgba(92,65,38,.03) 0 .7px,transparent .8px 4px),var(--paper-light);box-shadow:0 24px 58px rgba(52,39,27,.14),0 3px 10px rgba(52,39,27,.08),inset 0 1px rgba(255,255,255,.9);animation:page-arrival 720ms cubic-bezier(.22,1,.36,1) both}
  .diary-paper::before{position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(96,68,39,.035),transparent 7%,transparent 93%,rgba(96,68,39,.025));content:""}
  .diary-paper>*{position:relative;z-index:1}
  .diary-paper__heading{text-align:center}.diary-paper__heading :global(.book-ornament){width:3rem;margin:0 auto 1.4rem}.diary-paper__heading p{margin:0;color:var(--accent);font-size:.66rem;letter-spacing:.24em;text-transform:uppercase}.diary-paper__date-label{display:grid;justify-items:center;gap:.45rem;margin-top:.8rem}.diary-paper__date-label span{color:var(--muted);font-size:.62rem;letter-spacing:.18em;text-transform:uppercase}.diary-paper input.diary-paper__date{width:auto;margin:0;padding:.2rem .35rem;border:0;border-bottom:1px solid transparent;background:transparent;color:var(--accent);font-family:var(--font-heading);font-size:1rem;text-align:center;cursor:pointer;transition:border-color var(--transition-fast)}.diary-paper input.diary-paper__date:hover,.diary-paper input.diary-paper__date:focus{border-bottom-color:var(--line)}
  .diary-paper input{display:block;width:100%;margin:clamp(2.4rem,6vw,4rem) 0 0;padding:0;border:0;outline:0;background:transparent;color:var(--ink);text-align:center;font-family:var(--font-heading);font-size:clamp(2.8rem,7.5vw,5.4rem);font-weight:500;line-height:.98}
  .diary-paper input::placeholder{color:color-mix(in srgb,var(--muted) 45%,transparent)}
  .diary-paper__divider{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem;width:min(100%,300px);margin:clamp(2.2rem,5vw,3.4rem) auto clamp(3rem,7vw,5rem);color:var(--accent)}.diary-paper__divider span{height:1px;background:linear-gradient(90deg,transparent,var(--line))}.diary-paper__divider span:last-child{background:linear-gradient(90deg,var(--line),transparent)}.diary-paper__divider b{font-size:.65rem;font-weight:400}
  .diary-paper textarea{display:block;width:min(100%,680px);min-height:380px;max-height:min(52svh,560px);margin:0 auto;padding:0;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable;resize:none;border:0;outline:0;background:transparent;color:var(--ink);font-family:var(--font-body);font-size:clamp(1.08rem,2vw,1.24rem);line-height:1.9}.diary-paper textarea::placeholder{color:color-mix(in srgb,var(--muted) 55%,transparent)}
  .diary-paper__footer{width:min(100%,680px);margin:3rem auto 0;padding-top:1.1rem;border-top:1px solid var(--line)}
  .diary-paper__footer :global(.meta){display:flex;justify-content:space-between;gap:1rem;color:var(--muted);font-size:.74rem}.diary-paper__footer #form-message{min-height:1.3rem;margin:.8rem 0 0;color:#9a493f;text-align:center;font-size:.85rem}
  .diary-paper :global(.actions){display:flex;align-items:center;justify-content:flex-end;gap:1rem;width:min(100%,680px);margin:1.2rem auto 0}.diary-paper :global(.actions a){color:var(--muted)}.diary-paper :global(.actions button){padding:.9rem 1.45rem;border:1px solid var(--ink);background:var(--ink);color:var(--paper-light)}
  @media(max-width:680px){.diary-writing{width:100%;padding:0}.diary-writing__toolbar{padding:1rem 1rem .75rem}.diary-writing__toolbar span{display:none}.diary-paper{min-height:calc(100svh - 3.5rem);border:0;border-radius:0;box-shadow:none;padding:3.5rem 1.2rem 1.5rem}.diary-paper input{font-size:clamp(2.65rem,13vw,4rem)}.diary-paper textarea{font-size:1.04rem;line-height:1.82}.diary-paper :global(.actions){align-items:center}.diary-paper :global(.actions button){flex:1}.diary-paper :global(.actions a){padding:.8rem}}
  @keyframes draft-pulse{50%{transform:scale(1.55);opacity:.45}}
  @media(prefers-reduced-motion:reduce){.diary-paper{animation:none}.draft-indicator::before{animation:none!important}:global(body.is-leaving){transform:none}}
</style>
