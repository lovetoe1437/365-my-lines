---
import AppLayout from "../layouts/AppLayout.astro";
import Button from "../components/ui/Button.astro";

const error = Astro.url.searchParams.get("error");

const errorMessage =
  error === "wrong-password"
    ? "Неверный пароль. Попробуйте ещё раз."
    : error === "invalid"
      ? "Введите пароль."
      : null;
---

<AppLayout
  title="Вход"
  description="Вход в личную книгу «365 моих строк»."
  class="login-page"
>
  <section class="login">
    <div class="login__decoration login__decoration--left" aria-hidden="true">
      <svg viewBox="0 0 180 260" fill="none">
        <path
          d="M140 251C105 197 93 148 96 96C98 61 111 31 132 9"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        />
        <path
          d="M98 116C69 102 51 82 44 55C69 57 89 74 98 99"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M104 70C88 48 84 27 92 8C110 22 118 43 108 64"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M97 165C69 157 49 140 38 116C66 113 88 126 99 149"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </div>

    <div class="login__card paper-surface">
      <header class="login__header">
        <p class="login__eyebrow">Личная книга</p>

        <h1 class="login__title">365 моих строк</h1>

        <p class="login__subtitle">
          Место, где мысли остаются жить.
        </p>

        <div class="login__ornament" aria-hidden="true">
          <span></span>
          <svg viewBox="0 0 28 18" fill="none">
            <path
              d="M14 17C13 10 16 5 23 2C23 9 20 14 14 17Z"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linejoin="round"
            />
            <path
              d="M14 17C15 10 12 5 5 2C5 9 8 14 14 17Z"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linejoin="round"
            />
          </svg>
          <span></span>
        </div>
      </header>

      <form class="login__form" method="POST" action="/api/login">
        <div class="login__field">
          <label for="password">Пароль</label>

          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            placeholder="Введите пароль"
            required
            autofocus
            aria-describedby={errorMessage ? "login-error" : undefined}
            aria-invalid={errorMessage ? "true" : undefined}
          />
        </div>

        {
          errorMessage && (
            <p class="login__error" id="login-error" role="alert">
              {errorMessage}
            </p>
          )
        }

        <Button type="submit" fullWidth>
          Войти
          <svg
            class="login__button-icon"
            viewBox="0 0 20 20"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4 10H16M11 5L16 10L11 15"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </Button>
      </form>

      <p class="login__note">
        Продолжение личной истории, страница за страницей.
      </p>
    </div>

    <div class="login__decoration login__decoration--right" aria-hidden="true">
      <svg viewBox="0 0 170 250" fill="none">
        <path
          d="M25 241C53 188 70 138 72 89C73 55 63 29 44 8"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        />
        <path
          d="M71 109C98 94 115 74 120 48C94 52 76 69 70 93"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M66 65C82 45 87 25 80 7C62 20 55 41 64 60"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M70 158C97 148 116 130 124 106C97 105 77 119 68 143"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </div>
  </section>
</AppLayout>

<style>
  :global(.login-page .app-shell) {
    display: grid;
    place-items: center;
  }

  .login {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    min-height: calc(100vh - 3rem);
    padding: var(--space-5) 0;
  }

  .login__card {
    position: relative;
    z-index: 1;
    width: min(100%, 29rem);
    padding: clamp(2rem, 7vw, 3.5rem);
    overflow: hidden;
  }

  .login__card::before {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: "";
    opacity: 0.35;
    background-image:
      repeating-linear-gradient(
        0deg,
        transparent 0,
        transparent 3px,
        rgba(78, 60, 44, 0.018) 4px
      );
  }

  .login__header,
  .login__form,
  .login__note {
    position: relative;
    z-index: 1;
  }

  .login__header {
    margin-bottom: var(--space-6);
    text-align: center;
  }

  .login__eyebrow {
    margin-bottom: var(--space-3);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .login__title {
    margin-bottom: var(--space-3);
    font-size: clamp(2.6rem, 10vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .login__subtitle {
    margin-bottom: var(--space-5);
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .login__ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    color: var(--color-accent);
  }

  .login__ornament span {
    width: 3.5rem;
    height: 1px;
    background: var(--color-line);
  }

  .login__ornament svg {
    width: 1.75rem;
  }

  .login__form {
    display: grid;
    gap: var(--space-4);
  }

  .login__field {
    display: grid;
    gap: var(--space-2);
  }

  .login__field label {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .login__field input {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    outline: none;
    background: rgba(255, 255, 255, 0.28);
    color: var(--color-ink);
    box-shadow: inset 0 1px 2px rgba(54, 43, 33, 0.04);
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .login__field input::placeholder {
    color: color-mix(in srgb, var(--color-muted) 70%, transparent);
  }

  .login__field input:hover {
    border-color: rgba(128, 102, 79, 0.45);
  }

  .login__field input:focus {
    border-color: var(--color-accent);
    background: rgba(255, 255, 255, 0.42);
    box-shadow:
      0 0 0 3px rgba(128, 102, 79, 0.12),
      inset 0 1px 2px rgba(54, 43, 33, 0.04);
  }

  .login__field input[aria-invalid="true"] {
    border-color: #9a5147;
  }

  .login__error {
    margin: -0.25rem 0 0;
    padding: 0.65rem 0.8rem;
    border: 1px solid rgba(154, 81, 71, 0.2);
    border-radius: var(--radius-sm);
    background: rgba(154, 81, 71, 0.07);
    color: #82463f;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .login__button-icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  .login__note {
    max-width: 19rem;
    margin: var(--space-5) auto 0;
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.7;
    text-align: center;
  }

  .login__decoration {
    position: absolute;
    display: none;
    width: 10rem;
    color: var(--color-accent);
    opacity: 0.3;
    pointer-events: none;
  }

  .login__decoration--left {
    bottom: 0;
    left: max(0rem, calc(50% - 30rem));
  }

  .login__decoration--right {
    top: 0;
    right: max(0rem, calc(50% - 30rem));
  }

  @media (min-width: 48rem) {
    .login {
      min-height: calc(100vh - 6rem);
    }

    .login__decoration {
      display: block;
    }
  }

  @media (max-width: 30rem) {
    .login__card {
      border-radius: var(--radius-md);
    }
  }
</style>