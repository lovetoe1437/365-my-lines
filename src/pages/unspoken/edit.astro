---
import AppLayout from "../../layouts/AppLayout.astro";
import { env } from "cloudflare:workers";
import { getUnspoken } from "../../lib/db/unspoken";

export const prerender = false;
const content = await getUnspoken(env.DB);
---

<AppLayout title="Редактировать Unspoken" description="Редактор скрытой страницы книги." class="unspoken-editor-page" noindex>
  <section class="editor-shell">
    <a class="editor-back" href="/unspoken">← Открыть страницу</a>

    <form class="unspoken-editor" id="unspoken-editor">
      <header>
        <p>Настройки страницы</p>
        <h1>Редактировать Unspoken</h1>
        <span>Изменения появятся сразу после сохранения — новый деплой не потребуется.</span>
      </header>

      <fieldset class="visibility">
        <legend>Где показывать страницу</legend>
        <label><input type="radio" name="visibility" value="hidden" checked={content.visibility === "hidden"} /><span><strong>Скрытая</strong><small>Доступна только по прямой ссылке <code>/unspoken</code>.</small></span></label>
        <label><input type="radio" name="visibility" value="epilogue" checked={content.visibility === "epilogue"} /><span><strong>Эпилог книги</strong><small>Появится в конце оглавления как последняя особая страница.</small></span></label>
        <label><input type="radio" name="visibility" value="link" checked={content.visibility === "link"} /><span><strong>Отдельная ссылка</strong><small>Небольшая ненавязчивая ссылка появится внизу страницы дневника.</small></span></label>
      </fieldset>

      <div class="fields">
        <label><span>Надпись над заголовком</span><input name="eyebrow" value={content.eyebrow} /></label>
        <label><span>Заголовок</span><input class="title-input" name="title" value={content.title} required /></label>
        <label><span>Вступление</span><small>Каждый абзац отделяй пустой строкой.</small><textarea name="opening" rows="10" maxlength="20000" required>{content.opening.join("\n\n")}</textarea></label>
        <label><span>Заголовок основной части</span><input name="sectionTitle" value={content.sectionTitle} required /></label>
        <label><span>Основной текст</span><small>Каждый абзац отделяй пустой строкой.</small><textarea name="story" rows="20" maxlength="20000" required>{content.story.join("\n\n")}</textarea></label>

        <div class="two-columns">
          <label><span>Подпись</span><input name="signature" value={content.signature} /></label>
          <label><span>Фраза под подписью</span><input name="motto" value={content.motto} /></label>
          <label><span>Версия</span><input name="version" value={content.version} /></label>
          <label><span>Дата</span><input name="date" value={content.date} /></label>
        </div>
      </div>

      <p class="form-message" id="form-message" role="status"></p>
      <footer>
        <span id="draft-status">Все изменения сохраняются локально как черновик</span>
        <div><a href="/unspoken">Отмена</a><button type="submit">Сохранить страницу</button></div>
      </footer>
    </form>
  </section>
</AppLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#unspoken-editor");
  const message = document.querySelector<HTMLElement>("#form-message");
  const status = document.querySelector<HTMLElement>("#draft-status");
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const key = "365-unspoken-draft-v1";
  let timer: number | undefined;

  const formSnapshot = () => form ? Object.fromEntries(new FormData(form).entries()) : {};
  const saveDraft = () => {
    if (!form) return;
    localStorage.setItem(key, JSON.stringify(formSnapshot()));
    if (status) status.textContent = "Черновик сохранён на этом устройстве";
  };

  try {
    const saved = localStorage.getItem(key);
    if (saved && form) {
      const draft = JSON.parse(saved) as Record<string, string>;
      Object.entries(draft).forEach(([name, value]) => {
        const field = form.elements.namedItem(name);
        if (field instanceof RadioNodeList) field.value = value;
        else if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) field.value = value;
      });
      if (status) status.textContent = "Несохранённый черновик восстановлен";
    }
  } catch { localStorage.removeItem(key); }

  form?.addEventListener("input", () => {
    if (status) status.textContent = "Сохраняем черновик…";
    window.clearTimeout(timer);
    timer = window.setTimeout(saveDraft, 450);
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !button) return;
    message && (message.textContent = "");
    button.disabled = true;
    button.textContent = "Сохраняем…";
    try {
      const response = await fetch("/api/unspoken", { method: "PUT", body: new FormData(form) });
      const result = await response.json();
      if (response.status === 401) {
        if (message) message.textContent = result.message ?? "Сессия завершилась. Войдите снова.";
        button.disabled = false;
        button.textContent = "Сохранить страницу";
        window.showAppDialog?.({ eyebrow: "Доступ к редактору", title: "Сессия завершилась", message: result.message ?? "Для продолжения необходимо снова войти.", actionLabel: "Войти", actionHref: "/login" });
        return;
      }
      if (!response.ok || !result.ok) throw new Error(result.message ?? "Не удалось сохранить страницу.");
      localStorage.removeItem(key);
      button.textContent = "Сохранено ✓";
      if (status) status.textContent = "Изменения опубликованы";
      window.setAppToastForNextPage?.({ tone: "success", title: "Страница сохранена", message: "Изменения опубликованы." });
      window.setTimeout(() => { window.location.href = "/unspoken"; }, 500);
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : "Не удалось сохранить страницу.";
      if (message) message.textContent = errorMessage;
      window.showAppToast?.({ tone: "error", title: "Не удалось сохранить", message: errorMessage });
      button.disabled = false;
      button.textContent = "Сохранить страницу";
    }
  });
</script>

<style>
  :global(body.unspoken-editor-page){background:var(--paper)}
  .editor-shell{width:min(calc(100% - 2rem),980px);margin:0 auto;padding:2rem 0 6rem}.editor-back{color:var(--muted)}
  .unspoken-editor{margin-top:2rem;padding:clamp(1.5rem,5vw,4.5rem);border:1px solid var(--line);background:rgba(251,248,242,.68);box-shadow:0 24px 70px rgba(52,41,29,.06)}
  header{text-align:center}header p{margin:0;color:var(--accent);font-size:.65rem;letter-spacing:.22em;text-transform:uppercase}h1{margin:.8rem 0;font-size:clamp(2.8rem,7vw,4.8rem);font-weight:500}header>span{color:var(--muted);line-height:1.7}
  fieldset{margin:3rem 0;padding:0;border:0}legend,.fields label>span{display:block;margin-bottom:.7rem;color:var(--ink);font-family:var(--font-heading);font-size:1.15rem;font-weight:600}.visibility{display:grid;gap:.75rem}.visibility label{display:flex;gap:1rem;padding:1rem;border:1px solid var(--line);cursor:pointer;transition:border-color 180ms ease,background 180ms ease}.visibility label:has(input:checked){border-color:var(--accent);background:rgba(128,102,79,.06)}.visibility input{margin-top:.25rem;accent-color:var(--accent)}.visibility span{display:grid;gap:.2rem}.visibility strong{font-family:var(--font-heading);font-size:1.1rem}.visibility small{color:var(--muted);line-height:1.5}.visibility code{font-size:.8em}
  .fields{display:grid;gap:1.65rem}.fields label small{display:block;margin:-.4rem 0 .6rem;color:var(--muted)}input,textarea{box-sizing:border-box;width:100%;padding:.9rem 1rem;border:1px solid var(--line);outline:0;background:rgba(255,253,248,.72);color:var(--ink);font:inherit;transition:border-color 180ms ease,box-shadow 180ms ease}input:focus,textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(128,102,79,.08)}textarea{resize:vertical;line-height:1.75}.title-input{font-family:var(--font-heading);font-size:2rem}.two-columns{display:grid;grid-template-columns:1fr 1fr;gap:1.3rem}.form-message{min-height:1.5rem;color:#9a493f}
  footer{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:2rem;padding-top:1.4rem;border-top:1px solid var(--line);color:var(--muted);font-size:.85rem}footer div{display:flex;align-items:center;gap:1rem}footer a{color:var(--muted)}button{padding:.9rem 1.35rem;border:1px solid var(--ink);background:var(--ink);color:var(--paper-light);font:inherit;cursor:pointer}button:disabled{opacity:.65;cursor:default}
  @media(max-width:680px){.editor-shell{padding-top:1rem}.unspoken-editor{padding:1.3rem}.two-columns{grid-template-columns:1fr}footer{align-items:flex-start;flex-direction:column}footer div{width:100%;justify-content:flex-end}}
</style>
