---
import AppLayout from "../layouts/AppLayout.astro";
import { env } from "cloudflare:workers";
import { getUnspoken } from "../lib/db/unspoken";
import { isAdmin } from "../lib/auth/session";
import { getBookLines } from "../lib/db/book-lines";

export const prerender = false;

const [content, admin, bookLines] = await Promise.all([
  getUnspoken(env.DB),
  isAdmin(Astro),
  getBookLines(env.DB),
]);

const lastLine = bookLines.at(-1) ?? null;
const source = Astro.url.searchParams.get("from");

const bookBackHref = lastLine
  ? `/lines/${String(lastLine.number).padStart(3, "0")}`
  : "/lines";

const navigationContext = source === "diary"
  ? { href: "/book", label: "Вернуться к дневнику" }
  : source === "book"
    ? {
        href: bookBackHref,
        label: lastLine ? `Вернуться к странице ${lastLine.number}` : "Вернуться к книге",
      }
    : content.visibility === "link"
      ? { href: "/book", label: "Вернуться к дневнику" }
      : content.visibility === "epilogue"
        ? {
            href: bookBackHref,
            label: lastLine ? `Вернуться к странице ${lastLine.number}` : "Вернуться к книге",
          }
        : { href: "/lines", label: "Вернуться к книге" };

const backHref = navigationContext.href;
const backLabel = navigationContext.label;
---

<AppLayout
  title="Unspoken"
  description="Скрытая страница о том, почему появилась книга «365 моих строк»."
  class="unspoken-page"
  hideNavigation
  noindex
>
  <article class="unspoken" aria-labelledby="unspoken-title">
    <img class="unspoken__branch unspoken__branch--top" src="/botanical-branch.svg" alt="" aria-hidden="true" />
    <img class="unspoken__branch unspoken__branch--bottom" src="/botanical-branch.svg" alt="" aria-hidden="true" />

    <header class="unspoken__header reveal reveal--1">
      <p class="unspoken__eyebrow">{content.eyebrow}</p>
      <h1 id="unspoken-title">{content.title}</h1>
      <span class="unspoken__mark" aria-hidden="true">✦</span>
    </header>

    <section class="unspoken__opening" aria-label="Вступление">
      {content.opening.map((paragraph, index) => (
        <p class={`reveal reveal--${index + 2}`}>{paragraph}</p>
      ))}
    </section>

    <div class="unspoken__divider reveal reveal--7" aria-hidden="true">
      <span></span><i>✦</i><span></span>
    </div>

    <section class="unspoken__story reveal reveal--8" aria-labelledby="unspoken-story-title">
      <h2 id="unspoken-story-title">{content.sectionTitle}</h2>
      {content.story.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <footer class="unspoken__footer reveal reveal--9">
      <div class="unspoken__signature">
        <strong>{content.signature}</strong>
        <em>{content.motto}</em>
      </div>
      <div class="unspoken__meta">
        <span>{content.version}</span>
        <span>{content.date}</span>
      </div>
      <div class="unspoken__actions">
        <a href={backHref} class="unspoken__back" aria-label={backLabel}>
          <span aria-hidden="true">←</span> {backLabel}
        </a>
        {admin && <a href="/unspoken/edit" class="unspoken__edit">Редактировать страницу ✎</a>}
      </div>
    </footer>
  </article>
</AppLayout>

<style>
  :global(body.unspoken-page){overflow-x:hidden;background:#f4eee3}
  :global(body.unspoken-page::before){opacity:.31}
  :global(body.unspoken-page .app-shell){min-height:100vh}

  .unspoken{position:relative;isolation:isolate;width:min(calc(100% - 2rem),860px);min-height:100vh;margin:0 auto;padding:clamp(4.5rem,10vw,8.5rem) clamp(1rem,5vw,4.5rem) clamp(4rem,8vw,7rem);overflow:hidden}
  .unspoken::before{position:absolute;inset:1.2rem 0;z-index:-2;border:1px solid rgba(86,65,48,.11);background:linear-gradient(180deg,rgba(255,253,248,.58),rgba(250,245,236,.34));box-shadow:0 28px 80px rgba(63,43,28,.08);content:""}
  .unspoken::after{position:absolute;inset:1.2rem 0;z-index:-1;pointer-events:none;content:"";background:radial-gradient(circle at 18% 6%,rgba(255,255,255,.78),transparent 24rem),linear-gradient(90deg,rgba(85,60,41,.025),transparent 16%,transparent 84%,rgba(85,60,41,.025))}

  .unspoken__branch{position:absolute;z-index:-1;width:clamp(125px,22vw,190px);opacity:.13;pointer-events:none;filter:sepia(.08) saturate(.72)}
  .unspoken__branch--top{top:1.5rem;right:-1.4rem;transform:rotate(8deg)}
  .unspoken__branch--bottom{bottom:1rem;left:-2.2rem;transform:scaleX(-1) rotate(9deg)}

  .unspoken__header{text-align:center}
  .unspoken__eyebrow{margin:0;color:var(--accent);font-size:.64rem;letter-spacing:.24em;text-transform:uppercase}
  .unspoken h1{margin:1.15rem 0 .65rem;font-size:clamp(3.8rem,9vw,6.4rem);font-weight:500;letter-spacing:-.045em}
  .unspoken__mark{display:block;color:#9a7758;font-size:.74rem}

  .unspoken__opening{display:grid;gap:.25rem;max-width:620px;margin:clamp(3rem,7vw,5.2rem) auto 0;text-align:center}
  .unspoken__opening p{margin:0;color:#493f37;font-family:var(--font-heading);font-size:clamp(1.34rem,3vw,1.75rem);line-height:1.62;text-wrap:balance}
  .unspoken__opening p:nth-child(3){margin-top:1.25rem}
  .unspoken__opening p:last-child{color:#6b5747;font-style:italic}

  .unspoken__divider{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem;width:min(100%,420px);margin:clamp(3.4rem,8vw,5.8rem) auto;color:#a38468}
  .unspoken__divider span{height:1px;background:linear-gradient(90deg,transparent,rgba(88,66,49,.26))}
  .unspoken__divider span:last-child{background:linear-gradient(90deg,rgba(88,66,49,.26),transparent)}
  .unspoken__divider i{font-size:.64rem;font-style:normal}

  .unspoken__story{max-width:650px;margin:0 auto}
  .unspoken__story h2{margin:0 0 2rem;text-align:center;font-size:clamp(2rem,5vw,2.85rem);font-weight:500}
  .unspoken__story p{margin:0 0 1.35rem;color:#51463d;font-size:clamp(.98rem,1.9vw,1.08rem);line-height:1.95;text-wrap:pretty}
  .unspoken__story p:first-of-type::first-letter{float:left;margin:.08em .13em 0 0;color:#76583f;font-family:var(--font-heading);font-size:4.2em;line-height:.73}

  .unspoken__footer{display:grid;justify-items:center;margin-top:clamp(4rem,9vw,6.5rem);text-align:center}
  .unspoken__signature{display:grid;gap:.35rem}
  .unspoken__signature strong{font-family:var(--font-heading);font-size:1.55rem;font-weight:500}
  .unspoken__signature em{color:var(--muted);font-family:var(--font-heading);font-size:.92rem}
  .unspoken__meta{display:flex;gap:.8rem;margin-top:1.75rem;color:#8a7b6d;font-size:.61rem;letter-spacing:.18em;text-transform:uppercase}
  .unspoken__meta span+span::before{margin-right:.8rem;content:"·"}
  .unspoken__actions{display:grid;justify-items:center;gap:1rem;margin-top:3.8rem}
  .unspoken__back{display:inline-flex;align-items:center;gap:.7rem;padding:.7rem .2rem;border-bottom:1px solid rgba(85,63,47,.25);color:#685648;font-family:var(--font-heading);font-size:.9rem;transition:gap var(--transition-fast),color var(--transition-fast),border-color var(--transition-fast)}
  .unspoken__back:hover{gap:1rem;color:var(--ink);border-color:rgba(85,63,47,.5)}
  .unspoken__edit{color:var(--muted);font-size:.74rem;letter-spacing:.04em;transition:color var(--transition-fast)}
  .unspoken__edit:hover{color:var(--accent-dark)}

  .reveal{opacity:0;animation:unspoken-reveal 800ms cubic-bezier(.2,.7,.2,1) forwards}
  .reveal--1{animation-delay:80ms}.reveal--2{animation-delay:240ms}.reveal--3{animation-delay:380ms}.reveal--4{animation-delay:520ms}.reveal--5{animation-delay:660ms}.reveal--6{animation-delay:800ms}.reveal--7{animation-delay:920ms}.reveal--8{animation-delay:1040ms}.reveal--9{animation-delay:1160ms}
  @keyframes unspoken-reveal{from{opacity:0;transform:translateY(13px)}to{opacity:1;transform:none}}

  @media(max-width:640px){
    .unspoken{width:min(calc(100% - 1rem),860px);padding:4rem 1.55rem 3.5rem}
    .unspoken::before,.unspoken::after{inset:.45rem 0}
    .unspoken__branch--top{top:.5rem;right:-3rem}.unspoken__branch--bottom{bottom:.2rem;left:-3.6rem}
    .unspoken__opening{margin-top:2.8rem}.unspoken__opening p{font-size:1.27rem;line-height:1.58}
    .unspoken__story p{font-size:.96rem;line-height:1.86}
    .unspoken__meta{flex-direction:column;gap:.45rem}.unspoken__meta span+span::before{display:none}
    .unspoken__actions{margin-top:3rem}
  }

  @media(prefers-reduced-motion:reduce){.reveal{opacity:1;animation:none}}
</style>
