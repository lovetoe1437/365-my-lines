---
import AppLayout from "../layouts/AppLayout.astro";
import Button from "../components/ui/Button.astro";
import { env } from "cloudflare:workers";
import { getPages } from "../lib/db/pages";

export const prerender = false;

const pages = await getPages(env.DB);

const today = new Intl.DateTimeFormat("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
  weekday: "long",
}).format(new Date());

const formatPageDate = (value: string) => {
  const date = new Date(value.replace(" ", "T") + "Z");

  return new Intl.DateTimeFormat("ru-RU", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
};

const createExcerpt = (content: string) => {
  const normalized = content.replace(/\s+/g, " ").trim();

  if (normalized.length <= 180) {
    return normalized;
  }

  return `${normalized.slice(0, 180).trim()}…`;
};
---

<AppLayout
  title="Личный дневник"
  description="Личный дневник — продолжение книги 365 моих строк."
  class="book-page"
>
  <main class="book">
    <header class="book__header">
      <p class="book__eyebrow">Личный дневник</p>

      <h1 class="book__title">365 моих строк</h1>

      <p class="book__date">{today}</p>
    </header>

    <div class="book__divider" aria-hidden="true">
      <span></span>
      <span class="book__ornament">✦</span>
      <span></span>
    </div>

    <section class="book__welcome">
      <p class="book__greeting">Добро пожаловать.</p>

      <p>
        Сегодня ты можешь оставить<br />
        ещё одну страницу своей истории.
      </p>
    </section>

    <div class="book__actions">
      <Button href="/write">
        Написать запись
      </Button>
    </div>

    {
      pages.length > 0 ? (
        <section class="pages" aria-labelledby="pages-title">
          <div class="pages__heading">
            <span></span>
            <h2 id="pages-title">Последние страницы</h2>
            <span></span>
          </div>

          <div class="pages__list">
            {
              pages.map((page) => (
                <a class="page-preview" href={`/pages/${page.id}`}>
                  <p class="page-preview__date">
                    {formatPageDate(page.created_at)}
                  </p>

                  <h3 class="page-preview__title">
                    {page.title}
                  </h3>

                  <p class="page-preview__content">
                    {createExcerpt(page.content)}
                  </p>
                </a>
              ))
            }
          </div>
        </section>
      ) : (
        <section class="empty-state">
          <p class="empty-state__title">
            Пока здесь нет страниц.
          </p>

          <p>
            Первая запись всегда особенная.<br />
            Именно с неё начинается история.
          </p>
        </section>
      )
    }

    <footer class="book__footer">
      <p>Продолжение личной истории, страница за страницей.</p>
    </footer>
  </main>
</AppLayout>

<style>
  :global(.book-page) {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at top left,
        rgba(128, 102, 79, 0.08),
        transparent 36%
      ),
      radial-gradient(
        circle at bottom right,
        rgba(128, 102, 79, 0.06),
        transparent 34%
      ),
      var(--paper);
  }

  .book {
    width: min(100%, 760px);
    margin: 0 auto;
    padding: clamp(4rem, 8vw, 7rem) 1.5rem 3rem;
    text-align: center;
  }

  .book__header {
    display: grid;
    gap: 0.75rem;
  }

  .book__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .book__title {
    margin: 0;
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.8rem, 7vw, 4.8rem);
    font-weight: 600;
    line-height: 0.98;
    color: var(--ink);
  }

  .book__date {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    color: var(--muted);
    text-transform: capitalize;
  }

  .book__divider {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    width: min(100%, 420px);
    margin: 2.5rem auto;
    color: var(--accent);
  }

  .book__divider span:not(.book__ornament) {
    height: 1px;
    background: var(--line);
  }

  .book__ornament {
    font-size: 0.8rem;
  }

  .book__welcome {
    display: grid;
    gap: 1rem;
    width: min(100%, 560px);
    margin: 0 auto;
    font-size: clamp(1rem, 2vw, 1.1rem);
    line-height: 1.85;
    color: var(--ink);
  }

  .book__welcome p {
    margin: 0;
  }

  .book__greeting {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .book__actions {
    margin-top: 2.5rem;
  }

.pages {
  width: 100%;
  margin-top: clamp(3.5rem, 7vw, 5rem);
  text-align: left;
}

.pages__heading,
.pages__list,
.page-preview {
  text-align: left;
}

  .pages__heading {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .pages__heading span {
    height: 1px;
    background: var(--line);
  }

  .pages__heading h2 {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pages__list {
    display: grid;
  }

.page-preview {
  display: block;
  width: 100%;
  padding: 2.2rem 0;
  border-bottom: 1px solid var(--line);

  color: inherit;
  text-decoration: none;
  transition: opacity 180ms ease;
}
.page-preview:hover {
  opacity: 0.72;
}

  .page-preview__date {
    margin: 0 0 0.8rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .page-preview__title {
    margin: 0;
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(1.9rem, 4vw, 2.5rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--ink);
  }

  .page-preview__content {
    margin: 1rem 0 0;
    max-width: 650px;
    font-size: 1rem;
    line-height: 1.85;
    color: var(--ink);
  }

  .empty-state {
    margin-top: clamp(5rem, 10vw, 7rem);
    padding-top: 3rem;
    border-top: 1px solid var(--line);
    line-height: 1.8;
    color: var(--muted);
  }

  .empty-state p {
    margin: 0;
  }

  .empty-state__title {
    margin-bottom: 0.75rem !important;
    font-family: "Cormorant Garamond", serif;
    font-size: 2rem;
    font-weight: 600;
    color: var(--ink);
  }

  .book__footer {
    margin-top: clamp(4rem, 10vw, 7rem);
    font-size: 0.85rem;
    color: var(--muted);
  }

  .book__footer p {
    margin: 0;
  }

  @media (max-width: 520px) {
    .book {
      padding-top: 3rem;
    }

    .book__divider {
      margin-block: 2rem;
    }

    .book__actions :global(a) {
      width: 100%;
    }

    .pages__heading {
      gap: 0.7rem;
    }

    .pages__heading h2 {
      font-size: 0.7rem;
      letter-spacing: 0.12em;
    }

    .page-preview {
      padding: 2.2rem 0;
    }
  }
</style>