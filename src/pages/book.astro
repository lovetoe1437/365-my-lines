---
import AppLayout from "../layouts/AppLayout.astro";
import BookOrnament from "../components/book/BookOrnament.astro";
import { env } from "cloudflare:workers";
import { getPages } from "../lib/db/pages";
import { getUnspoken } from "../lib/db/unspoken";
import { formatLongDate } from "../lib/ui/date";

export const prerender = false;

const [pages, unspoken] = await Promise.all([getPages(env.DB), getUnspoken(env.DB)]);

const createExcerpt = (content: string) => {
  const normalized = content.replace(/\s+/g, " ").trim();
  return normalized.length <= 150 ? normalized : `${normalized.slice(0, 150).trim()}…`;
};

const getPagesLabel = (count: number) => {
  const lastTwo = count % 100;
  const last = count % 10;
  if (lastTwo >= 11 && lastTwo <= 14) return `${count} записей`;
  if (last === 1) return `${count} запись`;
  if (last >= 2 && last <= 4) return `${count} записи`;
  return `${count} записей`;
};
---

<AppLayout title="Дневник" description="Личный дневник — живое продолжение книги 365 моих строк." class="diary-page">
  <main class="diary-book" aria-labelledby="diary-title">
    <header class="diary-book__intro">
      <BookOrnament />
      <p class="diary-book__eyebrow">Живое продолжение</p>
      <h1 id="diary-title">Личный дневник</h1>
      <p class="diary-book__lead">То, что не всегда получается сказать сразу.</p>
      <div class="diary-book__summary">
        <span>{getPagesLabel(pages.length)}</span>
        <i aria-hidden="true"></i>
        <a href="/diary/write">Написать новую запись <span aria-hidden="true">→</span></a>
      </div>
    </header>

    {pages.length > 0 ? (
      <ol class="diary-list">
        {pages.map((page, index) => (
          <li class="diary-list__item" style={`--entry-delay:${120 + index * 55}ms`}>
            <a class="diary-list__link" href={`/pages/${page.id}`} data-diary-link aria-label={`Открыть запись: ${page.title}`}>
              <span class="diary-list__number">{index + 1}</span>
              <span class="diary-list__copy">
                <time datetime={page.entry_date}>{formatLongDate(`${page.entry_date}T00:00:00`)}</time>
                <strong>{page.title}</strong>
                <span>{createExcerpt(page.content)}</span>
              </span>
              <span class="diary-list__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <section class="diary-empty">
        <p>Здесь пока тихо</p>
        <h2>Первая запись ещё впереди.</h2>
        <span>Не нужно ждать идеального момента. Иногда началом становится всего одна честная мысль.</span>
        <a href="/diary/write">Открыть чистую страницу →</a>
      </section>
    )}

    {unspoken.visibility === "link" && (
      <a class="unspoken-link" href="/unspoken?from=diary">
        <span>Есть слова, которые невозможно сказать вслух.</span>
        <strong>{unspoken.title} →</strong>
      </a>
    )}

    <footer class="diary-book__footer">
      <span aria-hidden="true"></span>
      <p>Страница за страницей. День за днём.</p>
      <span aria-hidden="true"></span>
    </footer>
  </main>

  <div class="diary-opening" data-diary-opening aria-hidden="true">
    <span class="diary-opening__mark" aria-hidden="true">✦</span>
    <p>Открываем запись…</p>
  </div>
</AppLayout>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-diary-opening]");
  document.querySelectorAll<HTMLAnchorElement>("[data-diary-link]").forEach((link) => {
    link.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || link.target === "_blank") return;
      event.preventDefault();
      overlay?.classList.add("is-visible");
      overlay?.setAttribute("aria-hidden", "false");
      window.setTimeout(() => { window.location.href = link.href; }, 360);
    });
  });
</script>

<style>
  :global(body.diary-page){background:radial-gradient(circle at 50% -12%,rgba(255,255,255,.86),transparent 35rem),linear-gradient(135deg,#eee5d8 0%,var(--paper) 55%,#e9ddce 100%)}
  .diary-book{width:min(calc(100% - 3rem),940px);min-height:calc(100svh - 68px);margin:0 auto;padding:clamp(4rem,9vw,7rem) 0 3rem}
  .diary-book__intro{max-width:44rem;margin:0 auto clamp(3rem,7vw,5rem);text-align:center;animation:reveal 680ms ease both}
  .diary-book__intro :global(.book-ornament){width:3.6rem;margin:0 auto 1.7rem}
  .diary-book__eyebrow{margin:0 0 .85rem;color:var(--accent);font-size:.66rem;letter-spacing:.24em;text-transform:uppercase}
  h1{margin:0;font-size:clamp(3.4rem,9vw,6rem);font-weight:500;line-height:.94;letter-spacing:-.04em}
  .diary-book__lead{margin:1.1rem 0 0;color:var(--muted);font-family:var(--font-heading);font-size:clamp(1.08rem,2.4vw,1.35rem);font-style:italic}
  .diary-book__summary{display:flex;align-items:center;justify-content:center;gap:1rem;margin-top:2rem;color:var(--muted);font-family:var(--font-heading);font-size:.92rem}
  .diary-book__summary i{width:1px;height:1.2rem;background:var(--line)}
  .diary-book__summary a{color:var(--accent-dark);transition:transform var(--transition-fast),color var(--transition-fast)}
  .diary-book__summary a:hover{color:var(--ink);transform:translateX(2px)}
  .diary-list{margin:0;padding:0;border-top:1px solid var(--line);list-style:none}
  .diary-list__item{border-bottom:1px solid var(--line);animation:reveal 560ms var(--entry-delay) ease both}
  .diary-list__link{position:relative;display:grid;grid-template-columns:4rem minmax(0,1fr) 2rem;align-items:center;gap:clamp(1rem,4vw,2.8rem);padding:clamp(1.6rem,4vw,2.35rem) 1rem;color:var(--ink);transition:background var(--transition-fast),padding-left var(--transition-normal)}
  .diary-list__link::before{position:absolute;top:50%;left:0;width:1px;height:0;background:var(--accent);content:"";transform:translateY(-50%);transition:height var(--transition-normal)}
  .diary-list__link:hover{padding-left:1.55rem;background:rgba(252,248,240,.58)}
  .diary-list__link:hover::before{height:3rem}
  .diary-list__number{align-self:start;padding-top:.2rem;color:var(--accent-dark);font-family:var(--font-heading);font-size:1.08rem;font-variant-numeric:tabular-nums}
  .diary-list__copy{display:grid;gap:.42rem;min-width:0}
  .diary-list time{color:var(--muted);font-family:var(--font-heading);font-size:.86rem;text-transform:lowercase}
  .diary-list strong{font-family:var(--font-heading);font-size:clamp(1.7rem,4vw,2.45rem);font-weight:500;line-height:1.05;transition:color var(--transition-fast)}
  .diary-list__link:hover strong{color:var(--accent-dark)}
  .diary-list__copy>span{max-width:42rem;color:var(--muted);font-size:.95rem;line-height:1.75}
  .diary-list__arrow{justify-self:end;color:var(--muted-soft);font-size:1.1rem;transition:color var(--transition-fast),transform var(--transition-normal)}
  .diary-list__link:hover .diary-list__arrow{color:var(--accent);transform:translateX(5px)}
  .diary-empty{padding:clamp(4rem,10vw,7rem) 1rem;border-top:1px solid var(--line);border-bottom:1px solid var(--line);text-align:center}
  .diary-empty p{margin:0 0 1rem;color:var(--accent);font-size:.68rem;letter-spacing:.23em;text-transform:uppercase}
  .diary-empty h2{margin:0;font-size:clamp(2.5rem,7vw,4.5rem)}
  .diary-empty span{display:block;max-width:35rem;margin:1.5rem auto 0;color:var(--muted);line-height:1.8}
  .diary-empty a{display:inline-block;margin-top:2rem;padding-bottom:.3rem;border-bottom:1px solid var(--line)}
  .diary-book__footer{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem;margin-top:3.5rem;color:var(--muted);text-align:center}
  .diary-book__footer span{height:1px;background:var(--line)}
  .diary-book__footer p{margin:0;font-family:var(--font-heading);font-size:.95rem;font-style:italic}
  .diary-opening{position:fixed;inset:0;z-index:100;display:grid;place-content:center;gap:.9rem;background:rgba(43,37,31,.76);color:#fffaf2;text-align:center;opacity:0;visibility:hidden;backdrop-filter:blur(5px);transition:opacity 220ms ease,visibility 220ms ease}
  .diary-opening.is-visible{opacity:1;visibility:visible}.diary-opening__mark{font-size:1rem;animation:diaryPulse 900ms ease-in-out infinite}.diary-opening p{margin:0;font-family:var(--font-heading);font-size:1.1rem;font-style:italic}
  @keyframes diaryPulse{50%{opacity:.42;transform:scale(.86)}}

  .unspoken-link{display:grid;justify-items:center;gap:.35rem;width:min(100%,560px);margin:3.5rem auto 0;padding:1.7rem;border-top:1px solid var(--line);border-bottom:1px solid var(--line);color:var(--muted);text-align:center;transition:color var(--transition-fast),background var(--transition-fast)}
  .unspoken-link:hover{color:var(--ink);background:rgba(251,248,242,.45)}
  .unspoken-link span{font-family:var(--font-heading);font-style:italic}
  .unspoken-link strong{color:var(--accent-dark);font-family:var(--font-heading);font-size:1.25rem;font-weight:500}

  @media(max-width:640px){.diary-book{width:min(calc(100% - 2rem),940px);padding-top:3.5rem}.diary-book__summary{flex-wrap:wrap}.diary-list__link{grid-template-columns:2.5rem minmax(0,1fr) 1.5rem;gap:.8rem;padding-inline:0}.diary-list__link:hover{padding-left:.45rem}.diary-list__copy>span{font-size:.9rem}.diary-book__footer{grid-template-columns:1fr}.diary-book__footer span{display:none}}
  @media(prefers-reduced-motion:reduce){.diary-book__intro,.diary-list__item,.diary-opening__mark{animation:none}.diary-list__link,.diary-list__link::before,.diary-list__arrow,.diary-opening{transition:none}}
</style>
